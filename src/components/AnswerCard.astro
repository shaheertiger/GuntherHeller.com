---
import { type Food, cellsFor, contentFor } from "../lib/data";
interface Props { food: Food; id?: string; compactSource?: boolean }
const { food: f, id = "answer" } = Astro.props;
const portion = contentFor(f).portion;
const states = f.states.map((s, i) => ({ s, i, cells: cellsFor(f, s, i) }));
const group = `ac-${f.slug}-${id}`;
const sourceShort = f.source.name.startsWith("USDA") ? "USDA FoodKeeper" : f.source.name.split(":")[0];
const cols = [
  { k: "pantry", label: "On the counter", short: "Counter", dot: "bg-counter" },
  { k: "fridge", label: "In the fridge", short: "Fridge", dot: "bg-fridge" },
  { k: "freezer", label: "In the freezer", short: "Freezer", dot: "bg-freezer" },
] as const;
---
<section id={id} class="ac border border-line rounded-[10px] overflow-hidden" aria-label={`${f.name} storage times`}>
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 md:px-5 py-3 border-b border-line bg-panel">
    {states.length > 1 ? (
      <fieldset class="ac-toggle flex w-full md:w-auto md:inline-flex border border-line rounded-lg overflow-hidden bg-white m-0 p-0">
        <legend class="sr-only">Show storage times for</legend>
        {states.map(({ s, i }) => (
          <>
            <input class="sr-only" type="radio" name={group} id={`${group}-${i}`} data-i={i} checked={i === 0} />
            <label for={`${group}-${i}`} class="flex-1 md:flex-none justify-center">{s.label}</label>
          </>
        ))}
      </fieldset>
    ) : (
      <span class="text-sm font-medium">{f.name}</span>
    )}
    <span class="text-[13px] text-muted">Per {sourceShort}{portion && ` · ${portion}`}</span>
  </div>
  {states.map(({ i, cells }) => (
    <div class="ac-state grid-cols-3" data-i={i}>
      {cols.map((c, j) => (
        <div class:list={["px-3 py-4 md:px-5 md:py-[22px] min-w-0", j < 2 && "border-r border-line"]}>
          <div class="flex items-center gap-1.5 md:gap-2 text-[10px] md:text-[11px] font-medium tracking-[.06em] md:tracking-[.12em] uppercase text-muted items-start leading-tight">
            <span class:list={["dot", c.dot]}></span><span class="hidden md:inline min-w-0 hyphens-auto [overflow-wrap:anywhere]">{c.label}</span><span class="md:hidden min-w-0 hyphens-auto [overflow-wrap:anywhere]">{c.short}</span>
          </div>
          <div class:list={["mt-2 md:mt-2.5 font-[650] tracking-[-0.03em] leading-[1.05] break-words", /^\d/.test(cells[c.k].value) ? "text-[22px] md:text-[36px]" : "text-[17px] md:text-[26px]"]} >{cells[c.k].value}</div>
          <div class="mt-1.5 text-[12px] md:text-sm text-muted leading-snug">{cells[c.k].note}</div>
        </div>
      ))}
    </div>
  ))}
</section>
