---
interface Props { items: { name: string; href?: string }[]; small?: boolean }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-[13px] text-muted">
  <ol class="flex flex-wrap gap-2 list-none m-0 p-0">
    {items.map((it, i) => (
      <li class="flex gap-2">
        {i > 0 && <span aria-hidden="true">›</span>}
        {it.href ? <a href={it.href} class="text-muted hover:text-primary">{it.name}</a> : <span class="text-ink" aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
