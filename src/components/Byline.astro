---
/**
 * Who stands behind a page: the editorial team, the dietitian reviewer (linked to her profile) and, when she has
 * checked this page, the date of that review (data/reviewed.json).
 */
import { REVIEWER, personUrl, reviewedOn } from "../lib/people";
interface Props { path: string; updated: string; source?: string }
const { path, updated, source = "USDA FoodData Central" } = Astro.props;
const reviewed = reviewedOn(path);
const fmt = (iso: string) => new Date(iso + "T12:00:00Z").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<p class="byline text-[13px] text-muted mt-3 flex flex-wrap gap-x-2 gap-y-1">
  <span>By the <a class="link" href="/editorial-policy/">Gunther Heller editorial team</a></span>
  <span aria-hidden="true">·</span>
  {reviewed
    ? <span>Reviewed by <a class="link" href={personUrl(REVIEWER)}>{REVIEWER.name}, {REVIEWER.credentials}</a> on {fmt(reviewed)}</span>
    : <span>Editorial standards reviewed by <a class="link" href={personUrl(REVIEWER)}>{REVIEWER.name}, {REVIEWER.credentials}</a></span>}
  <span aria-hidden="true">·</span>
  <span>Data: {source}</span>
  <span aria-hidden="true">·</span>
  <span>Updated <time datetime={updated}>{fmt(updated)}</time></span>
</p>
