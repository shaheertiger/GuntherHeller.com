---
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<div class="mt-3.5">
  {items.map(([q, a]) => (
    <details class="faq-item border-b border-line">
      <summary class="flex justify-between items-center gap-3 py-3.5 text-[15px] font-medium min-h-11">{q}</summary>
      <div class="pb-4 text-[15px] text-muted">{a}</div>
    </details>
  ))}
</div>
