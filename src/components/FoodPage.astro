---
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import AnswerCard from "./AnswerCard.astro";
import MiniAnswer from "./MiniAnswer.astro";
import Signs from "./Signs.astro";
import FreezeBlock from "./FreezeBlock.astro";
import LeftOutBlock from "./LeftOutBlock.astro";
import FoodCard from "./FoodCard.astro";
import Faq from "./Faq.astro";
import AdSlot from "./AdSlot.astro";
import TrustBlock from "./TrustBlock.astro";
import FoodImage from "./FoodImage.astro";
import SectionHead from "./fun/SectionHead.astro";
import QuickAnswer from "./fun/QuickAnswer.astro";
import Badges from "./fun/Badges.astro";
import Timeline from "./fun/Timeline.astro";
import PerishScale from "./fun/PerishScale.astro";
import StillGood from "./fun/StillGood.astro";
import DangerZone from "./fun/DangerZone.astro";
import Icon from "./fun/Icon.astro";
import Countdown from "./fun/Countdown.astro";
import FridgeMap from "./fun/FridgeMap.astro";
import CompareChart from "./fun/CompareChart.astro";
import ToolsCta from "./fun/ToolsCta.astro";
import LongForm from "./LongForm.astro";
import Checker from "./fun/Checker.astro";
import Quiz from "./fun/Quiz.astro";
import Checklist from "./fun/Checklist.astro";
import { freezerChecks, counterChecks, quizFor, checklistFor } from "../lib/interactive";
import { faqExtraFor } from "../lib/longform";
import { modifierQA, thawFor, reheatFor, zoneFor } from "../lib/content";
import { range } from "../lib/viz";
import { primaryFridge, fmt, isNum, FOODS } from "../lib/data";
import { timelineBars, perishLevel, checker, VIZ_EN as V } from "../lib/viz";
import { freezeVerdict } from "../lib/content";
import { freezerFacts } from "../lib/data";
import { cellsFor } from "../lib/data";
import enStrings from "../../data/i18n/en.json";
import { type Food, url, getCategory, similarFoods, lc, does, titleCase, cap1, hasFreezePage, hasLeftOutPage } from "../lib/data";
import { foodTitle, foodDescription, quoteFor, methodsFor, datesFor, storeTipsFor, faqFor } from "../lib/content";
import { foodGraph } from "../lib/schema";
import { SITE } from "../lib/site";
import { foodAlternates } from "../lib/i18n";

interface Props { food: Food }
const { food: f } = Astro.props;
const path = url.food(f);
const cat = getCategory(f.category);
const sub = f.subcategory ? cat.subcategories.find((s) => s.slug === f.subcategory) : null;
const name = lc(f);
const h1 = `How Long ${does(f)} ${titleCase(f.name)} Last?`;
const title = foodTitle(f);
const description = foodDescription(f);
const crumbs = [
  { name: "Home", href: "/" },
  { name: cat.name, href: url.category(cat.slug) },
  ...(sub ? [{ name: sub.name, href: url.sub(cat.slug, sub.slug) }] : []),
  { name: f.name },
];
const faq = [...faqFor(f), ...faqExtraFor(f)];
const similar = similarFoods(f, 8);
const dates = datesFor(f);
const methods = methodsFor(f);
const quote = quoteFor(f);
const ld = foodGraph({ food: f, path, title, headline: h1, description, crumbs, faq });
const sourceIsFk = f.source.name.startsWith("USDA");
const c0 = cellsFor(f, f.states[0], 0);
const fv = freezeVerdict(f);
const badges = [
  f.perishable ? { label: V.badges.perishable, tone: "red" as const } : f.states[0].pantry ? { label: V.badges.shelf, tone: "green" as const } : null,
  fv.tone === "yes" ? { label: V.badges.freezes, tone: "blue" as const } : fv.tone === "no" ? { label: V.badges.noFreeze, tone: "amber" as const } : null,
  f.states.some((s) => s.key === "opened") ? { label: V.badges.opened, tone: "lilac" as const } : null,
].filter((b): b is NonNullable<typeof b> => !!b);
const bars = timelineBars(f);
const fzi = f.states.findIndex((s) => s.freezer);
const fzValue = fzi >= 0 ? cellsFor(f, f.states[fzi], fzi).freezer.value : c0.freezer.value;
const checks = checker(f);
const units = enStrings.units as Record<string, [string, string]>;
const TIP_ICONS = ["fridge", "box", "thermo", "calendar", "leaf"];
const fr = range(f.states[0].fridge);
const qa = modifierQA(f);
const fzChecks = freezerChecks(f);
const ctChecks = counterChecks(f);
const quiz = quizFor(f);
const thaw = isNum(freezerFacts(f)) ? thawFor(f) : null;
const reheat = reheatFor(f);
const zone = zoneFor(f);
const ZONES = { door: "Door", top: "Top shelf", middle: "Middle shelf", bottom: "Bottom shelf", crisper: "Crisper drawer", pantry: "Pantry", freezer: "Freezer" } as const;
const lifeOf = (x: Food) => { const s0 = x.states[0]; const d = range(s0.fridge) ?? range(s0.pantry); return d ? { days: d[1], label: fmt(s0.fridge && isNum(s0.fridge) ? s0.fridge : s0.pantry)! } : null; };
const compare = [f, ...similar.slice(0, 6)].map((x) => ({ x, l: lifeOf(x) })).filter((r) => r.l).map(({ x, l }) => ({ name: x.name, href: x === f ? undefined : url.food(x), days: l!.days, label: l!.label, me: x === f })).sort((a, b) => b.days - a.days);

const toc = [
  ["answer", "Quick answer"], ["glance", "At a glance"], ["check", "Check your food"], ["about", "About it"], ["methods", "Storage times by method"], ["where", "Where to store it"], ["qa", "Questions answered"], ["bad", "Signs it has gone bad"], ["freeze", "Can you freeze it?"],
  ["leftout", "Left out overnight"], ["dates", "Date labels"], ["store", "How to store it"], ["similar", "Similar foods"], ["quiz", "Quiz"], ["faq", "FAQ"],
];
const related = [
  hasFreezePage(f) && { href: url.freeze(f), label: `Can you freeze ${name}?` },
  { href: url.bad(f), label: `${does(f)} ${name} go bad?` },
  hasLeftOutPage(f) && { href: url.leftOut(f), label: `${cap1(name)} left out overnight` },
  similar[0] && { href: url.food(similar[0]), label: `How long ${does(similar[0]).toLowerCase()} ${lc(similar[0])} last?` },
].filter(Boolean) as { href: string; label: string }[];
const freezeHub = hasFreezePage(f) ? { href: "/can-you-freeze/", label: "Can you freeze… hub" } : { href: "/does-it-go-bad/", label: "Does it go bad? hub" };
const tools = [
  { href: "/tools/leftover-calculator/", label: "Leftover calculator" },
  { href: "/tools/freezer-time-calculator/", label: "Freezer time calculator" },
  { href: "/tools/left-out-checker/", label: "Left-out checker" },
];
---
<Base title={title} description={description} path={path} jsonld={ld} ogType="article" alternates={foodAlternates(f)}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />

    <div class="mt-3 md:mt-5 grid md:grid-cols-[minmax(0,1fr)_360px] items-center gap-x-10 gap-y-4">
      <div>
        <h1 class="h1-food">{h1}</h1>
        <p class="mt-1.5 md:mt-2 text-sm md:text-[17px] text-muted">Fridge, freezer, counter{f.states.length > 1 && ` · ${f.states.map((s) => s.label!.toLowerCase()).join(" vs ")}`} · last verified {SITE.verifiedLabel}</p>
        <Badges items={badges} />
      <div class="hidden md:flex items-center gap-2 text-[13px] text-muted mt-3">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2f8f5b" stroke-width="2"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
        Source: {sourceIsFk ? "USDA FoodKeeper" : f.source.name.split(":")[0]} · <a href="/methodology/" class="link">How we verify →</a>
      </div>
      </div>
      <FoodImage food={f} alt={`Illustration of ${name}`} variant="hero" />
    </div>

    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)_300px] gap-10 mt-4 md:mt-8 items-start">
      <aside class="hidden lg:block sticky top-[90px]" aria-label="On this page">
        <div class="eyebrow">On this page</div>
        <ul class="list-none mt-3 p-0 grid gap-0.5 text-sm">
          {toc.map(([id, label], i) => (
            <li><a href={`#${id}`} class="block py-1.5 pl-3 border-l-2 border-line text-muted hover:text-primary hover:border-primary">{label}</a></li>
          ))}
        </ul>
      </aside>

      <article class="min-w-0">
        <AnswerCard food={f} />
        <QuickAnswer label={V.quick} text={quote} />
        {f.derivedNote && <p class="mt-2 text-sm text-muted">{f.derivedNote}</p>}

        <nav aria-label="Sections" class="lg:hidden flex gap-2 overflow-x-auto -mx-4 px-4 mt-[18px] pb-1">
          {[["methods", "By method"], ["bad", "Gone bad?"], ["freeze", "Freezing"], ["leftout", "Left out"], ["faq", "FAQ"]].map(([id, l]) => (
            <a href={`#${id}`} class="whitespace-nowrap px-3 py-2 border border-line rounded-full text-[13px] font-medium min-h-9 inline-flex items-center">{l}</a>
          ))}
        </nav>

        {bars.length > 0 && (
          <section id="glance" class="mt-8 md:mt-12">
            <SectionHead icon="scale" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow="At a glance">{V.glance}</SectionHead>
            <Timeline bars={bars} labels={{ pantry: "Counter", fridge: "Fridge", freezer: "Freezer" }} values={{ pantry: c0.pantry.value, fridge: c0.fridge.value, freezer: fzValue }} ticks={V.ticks} note={V.glanceNote} plus={V.plus} />
            <div class="grid gap-3 mt-3">
              <PerishScale level={perishLevel(f)} title={V.perish} levels={V.levels} note={V.levelNote} />
              {checks && (
                <div id="still-good">
                  <StillGood checks={checks} V={V} units={units} id={`sg-${f.slug}`} />
                </div>
              )}
            </div>
          </section>
        )}

        {fr && fr[1] <= 14 && fr[1] >= 1 && (
          <section id="countdown" class="mt-8 md:mt-12">
            <SectionHead icon="calendar" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow="Meal prep">Your {name} fridge countdown</SectionHead>
            <Countdown min={fr[0]} max={fr[1]} startLabel={f.perishable ? "Made" : "Open"} dayWord="Day" labels={{ fresh: V.fresh, edge: V.edge, toss: V.toss }} title={`Day 0 is the day it was ${f.states[0].key === "opened" ? "opened" : f.kind === "cooked" ? "cooked" : "bought"}.`} note="Based on the USDA FoodKeeper fridge window at 4°C (40°F) or colder." />
          </section>
        )}

        {(fzChecks || ctChecks) && (
          <section id="check" class="mt-8 md:mt-14">
            <SectionHead icon="clock" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow="Try it">{`Check your ${name}`}</SectionHead>
            <div class="grid gap-3 mt-[18px]">
              {ctChecks && <Checker id={`ct-${f.slug}`} ask={f.perishable ? "It's been out on the counter for…" : "It's been in the pantry for…"} options={ctChecks} note={f.perishable ? "Room temperature means anything above 4°C (40°F). On hot days above 32°C (90°F), the limit is 1 hour." : "Assumes a cool, dry, dark cupboard with the package tightly closed."} />}
              {fzChecks && <Checker id={`fz-${f.slug}`} ask="It's been in the freezer for…" options={fzChecks} note="Assumes a freezer at -18°C (0°F) or colder. Frozen food stays safe; these verdicts are about quality." />}
            </div>
          </section>
        )}

        <LongForm food={f} parts={["about"]} />

        <section id="methods" class="mt-8 md:mt-14">
          <SectionHead icon="grid" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow="Every method">{cap1(name)} storage times by method</SectionHead>
          <div class="table-wrap mt-[18px] !rounded-[20px]">
            <table class="data-table stack">
              <thead><tr><th>Method</th><th>Duration</th><th>Temperature</th><th>Container</th><th>Notes</th></tr></thead>
              <tbody>
                {methods.map((m) => (
                  <tr><td class="font-medium full">{m.method}</td><td data-label="Duration">{m.duration}</td><td class="text-muted" data-label="Temperature">{m.temp}</td><td class="text-muted" data-label="Container">{m.container}</td><td class="text-muted full" data-label="Notes">{m.note}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>


        <section id="where" class="mt-8 md:mt-14">
          <SectionHead icon="fridge" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow="Where to keep it">{`Where to store ${name}`}</SectionHead>
          <FridgeMap zone={zone.zone} why={zone.why} names={ZONES} />
        </section>

        <section id="qa" class="mt-8 md:mt-14">
          <SectionHead icon="question" tint="var(--color-tint-blue)" ink="#2f5fbf" eyebrow="Question by question">{cap1(name)} shelf life, answered</SectionHead>
          <div class="grid gap-3 mt-[18px]">
            {qa.map(([q, a]) => (
              <div class="soft p-4 md:p-5 bg-[#f7f8fb] border border-[#e8ecf5]">
                <h3 class="!text-[17px] !tracking-[-0.01em]">{q}</h3>
                <p class="text-[15px] text-[#3f3f46] mt-1.5">{a}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="bad" class="mt-8 md:mt-14">
          <SectionHead icon="nose" tint="var(--color-tint-pink)" ink="#b83269" eyebrow="Check before you eat">{`Signs ${name} ${f.plural ? "have" : "has"} gone bad`}</SectionHead>
          <Signs food={f} />
          <Checklist id={`cl-${f.slug}`} title={`Check your ${name}: tick anything you notice`} items={checklistFor(f)} okText="Nothing ticked? Good sign. Still check how long it has been stored: the bacteria that cause food poisoning are invisible." badText="Any of these means it has gone bad. Throw it out — don't taste it to check." />
          <p class="mt-3 text-sm"><a href={url.bad(f)} class="link">{does(f)} {name} go bad? Full guide →</a></p>
        </section>

        <LongForm food={f} parts={["spoil", "mistakes"]} />

        <section id="freeze" class="mt-8 md:mt-14">
          <SectionHead icon="freezer" tint="var(--color-tint-blue)" ink="#2f5fbf" eyebrow="Freezing">Can you freeze {name}?</SectionHead>
          <FreezeBlock food={f} />
          {hasFreezePage(f) && <p class="mt-3 text-sm"><a href={url.freeze(f)} class="link">How to freeze and thaw {name} →</a></p>}
        </section>

        {thaw && (
          <section id="thaw" class="mt-8 md:mt-14">
            <SectionHead icon="thermo" tint="var(--color-tint-blue)" ink="#2f5fbf" eyebrow="Thawing">How to thaw {name}</SectionHead>
            <div class="grid sm:grid-cols-3 gap-3 mt-[18px]">
              {thaw.map(([t, d], i) => (
                <div class="lift soft p-4" style={`background:${["var(--color-tint-green)", "var(--color-tint-blue)", "var(--color-tint-amber)"][i]}`}>
                  <span class="icon-chip bg-white" style={`color:${["#1f7048", "#2f5fbf", "#8a5a0c"][i]}`}><Icon name={["fridge", "thermo", "clock"][i]} size={17} /></span>
                  <h3 class="!text-base !tracking-normal mt-2.5">{t}</h3><p class="text-sm text-[#3f3f46] mt-1">{d}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {reheat && (
          <section id="reheat" class="mt-8 md:mt-14">
            <SectionHead icon="spark" tint="var(--color-tint-red)" ink="#a5281b" eyebrow="Reheating">How to reheat {name} safely</SectionHead>
            <div class="grid sm:grid-cols-2 gap-3 mt-[18px]">
              {reheat.map(([t, d], i) => (
                <div class="soft p-4 border border-line flex gap-3"><span class="w-8 h-8 rounded-full grid place-items-center text-[15px] font-[650] text-white shrink-0" style="background:#c0392b">{i + 1}</span><div><h3 class="!text-base !tracking-normal">{t}</h3><p class="text-sm text-[#52525b] mt-0.5">{d}</p></div></div>
              ))}
            </div>
          </section>
        )}

        <section id="leftout" class="mt-8 md:mt-14">
          <SectionHead icon="clock" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow="The 2-hour rule">{cap1(name)} left out overnight</SectionHead>
          <LeftOutBlock food={f} />
          {f.perishable && <DangerZone title={V.dangerZone} text={V.dangerText} cold={V.safeCold} hot={V.safeHot} />}
          {hasLeftOutPage(f) && <p class="mt-3 text-sm"><a href={url.leftOut(f)} class="link">{cap1(name)} left out overnight: what to do →</a></p>}
        </section>

        <section id="dates" class="mt-8 md:mt-14">
          <SectionHead icon="calendar" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow="Date labels">Best-by and use-by dates on {name}</SectionHead>
          <div class="grid sm:grid-cols-2 gap-4 mt-[18px]">
            {[dates.unopened, dates.opened].map((d) => (
              <div class="soft p-5 bg-[#f7f7f8]"><h3 class="!text-[17px] !tracking-normal font-[650]">{d.title}</h3><p class="mt-1.5 text-[15px] text-[#52525b]">{d.text}</p></div>
            ))}
          </div>
        </section>

        <section id="store" class="mt-8 md:mt-14">
          <SectionHead icon="fridge" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow={V.tips}>How to store {name}</SectionHead>
          <ul class="grid sm:grid-cols-2 gap-3 list-none p-0 mt-4">{storeTipsFor(f).map((t, i) => (
            <li class="lift soft flex gap-3 p-4 border border-line"><span class="icon-chip" style="background:var(--color-tint-green);color:#1b7a55"><Icon name={TIP_ICONS[i % TIP_ICONS.length]} size={17} /></span><span class="text-[15px] leading-[1.55]">{t}</span></li>
          ))}</ul>
        </section>

        <LongForm food={f} parts={["buying"]} />

        {compare.length >= 3 && (
          <section id="compare" class="mt-8 md:mt-14">
            <SectionHead icon="scale" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow="How it compares">{cap1(name)} vs similar foods</SectionHead>
            <CompareChart rows={compare} title="Longest recommended storage time (fridge, or pantry for shelf-stable foods)" note="Same scale as the timeline above: 1 hour to 2 years." />
          </section>
        )}

        <ToolsCta title="Got something else in the fridge?" text="Check any food in seconds: when your leftovers expire, and whether something left out is still safe." links={[{ href: "/tools/leftover-calculator/", label: "Leftover calculator", icon: "calendar" }, { href: "/tools/left-out-checker/", label: "Left-out checker", icon: "clock" }, { href: "/foods/", label: `Browse ${FOODS.length} foods`, icon: "grid" }]} />

        <section id="similar" class="mt-8 md:mt-14">
          <SectionHead icon="leaf" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow="Keep exploring">Similar foods</SectionHead>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 md:gap-3 mt-[18px]">
            {similar.map((s) => <FoodCard food={s} />)}
          </div>
          <p class="mt-3.5 text-sm flex flex-wrap gap-x-2 gap-y-1">
            <a href={sub ? url.sub(cat.slug, sub.slug) : url.category(cat.slug)} class="link">All {(sub ?? cat).name.toLowerCase()} →</a><span aria-hidden="true">·</span>
            <a href={freezeHub.href} class="link">{freezeHub.label} →</a><span aria-hidden="true">·</span>
            {tools.map((t, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={t.href} class="link">{t.label} →</a></>)}
          </p>
        </section>

        <section id="quiz" class="mt-8 md:mt-14">
          <SectionHead icon="spark" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow="Quick quiz">{`True or false? ${cap1(name)} myths`}</SectionHead>
          <Quiz id={`qz-${f.slug}`} items={quiz} />
        </section>

        <section id="faq" class="mt-8 md:mt-14">
          <SectionHead icon="question" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow="Questions people ask">{cap1(name)} FAQ</SectionHead>
          <Faq items={faq} />
        </section>

        <TrustBlock path={path} sourceName={sourceIsFk ? "USDA FoodKeeper" : f.source.name} sourceUrl={f.source.url} extra={f.extraSource ? `and the ${f.extraSource.name}` : sourceIsFk ? "and FSIS guidance" : ""} />
      </article>

      <aside class="hidden lg:grid sticky top-[90px] gap-5" aria-label="Summary">
        <MiniAnswer food={f} />
        <AdSlot w={300} h={250} id="food-rail" />
        <div class="border border-line rounded-[10px] p-4">
          <div class="eyebrow">Related questions</div>
          <ul class="list-none mt-2.5 p-0 grid gap-2 text-sm">{related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </div>
</Base>
