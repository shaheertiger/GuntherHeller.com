---
import Logo from "./Logo.astro";
import { SITE } from "../lib/site";
import { NMETA, NCATS, RANKINGS, HUB_CHAINS, nurl } from "../lib/nutrition";
import { REVIEWER, personUrl } from "../lib/people";
const nutrients = RANKINGS.filter((r) => ["high-protein-foods", "high-fiber-foods", "low-calorie-foods", "low-carb-foods", "high-iron-foods"].includes(r.slug));
---
<footer class="site-foot">
  <div class="wrap">
    <div class="site-foot-top">
      <a href="/" class="flex items-center gap-2.5 font-[650] text-[19px]"><Logo size={24} /><span>Gunther Heller</span></a>
      <p class="text-sm text-muted max-w-[520px]">Calorie counts and nutrition labels for {NMETA.count.toLocaleString("en-US")} foods, worked out from USDA FoodData Central. For general information; it is not medical or dietary advice.</p>
    </div>
    <nav aria-label="Food categories" class="site-foot-row">
      <span class="site-foot-h">Categories</span>
      {NCATS.map((c) => <a href={nurl.cat(c.slug)}>{c.name}</a>)}
    </nav>
    <nav aria-label="Restaurants" class="site-foot-row">
      <span class="site-foot-h">Restaurants</span>
      <a href={nurl.restaurants()}>All restaurants</a>{HUB_CHAINS.slice(0, 8).map((c) => <a href={nurl.chain(c)}>{c.name}</a>)}
    </nav>
    <nav aria-label="Nutrient lists" class="site-foot-row">
      <span class="site-foot-h">Lists</span>
      {nutrients.map((r) => <a href={nurl.rank(r)}>{r.h1}</a>)}
    </nav>
    <nav aria-label="About this site" class="site-foot-row">
      <span class="site-foot-h">Site</span>
      <a href="/about/">About</a><a href="/methodology/">How we count</a><a href="/editorial-policy/">Editorial policy</a><a href={personUrl(REVIEWER)}>Reviewer: {REVIEWER.name}</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </nav>
    <p class="site-foot-legal">© 2026 Gunther Heller · Nutrition data: USDA FoodData Central (public domain)</p>
  </div>
</footer>
