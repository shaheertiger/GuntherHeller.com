---
import Logo from "./Logo.astro";
import Squiggle from "./Squiggle.astro";
import { SITE } from "../lib/site";
import { NMETA, NCATS, RANKINGS, nurl } from "../lib/nutrition";
const cols = [
  { h: "Browse", links: [["All foods", "/food/"], ...NCATS.slice(0, 6).map((c) => [c.name, nurl.cat(c.slug)])] },
  { h: "Nutrients", links: RANKINGS.slice(0, 7).map((r) => [r.h1.replace(/^Foods high in /, "High ").replace(/^Foods lowest in /, "Low "), nurl.rank(r)]) },
  { h: "Tools & site", links: [["Storage calculators", "/tools/"], ["Leftover calculator", "/tools/leftover-calculator/"], ["Our data", "/methodology/"], ["About & contact", "/about/"], ["Privacy", "/privacy/"], ["Terms", "/terms/"]] },
];
---
<footer class="bg-panel mt-24 pt-12 pb-8">
  <div class="container-site">
    <div class="grid gap-8 md:grid-cols-[1.2fr_.6fr_.6fr_.6fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-[650] text-[23px]"><Logo /><span>Gunther Heller</span></a>
        <Squiggle />
        <p class="mt-4 text-sm text-muted max-w-xs">Calories and nutrition facts for {NMETA.count.toLocaleString("en-US")} foods from USDA FoodData Central, with USDA FoodKeeper storage times. General information, not medical or dietary advice.</p>
        <p class="mt-3 text-[13px] text-muted"><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      {cols.map((c) => (
        <div>
          <h2 class="eyebrow mb-3.5 !text-[11px] !tracking-[.12em] !leading-normal">{c.h}</h2>
          <ul class="list-none m-0 p-0 grid gap-2 text-sm">
            {c.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="flex flex-wrap justify-between gap-3 border-t border-line mt-10 pt-[18px] text-[13px] text-muted">
      <span>© {new Date(SITE.verifiedISO).getFullYear()} Gunther Heller. Data: USDA FoodData Central and FoodKeeper (public domain).</span>
      <span class="flex flex-wrap gap-[18px]"><a href="/terms/">Terms of Service</a><a href="/privacy/">Privacy Policy</a></span>
    </div>
  </div>
</footer>
