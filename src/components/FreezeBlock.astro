---
import { type Food } from "../lib/data";
import { freezeVerdict, freezeStepsFor } from "../lib/content";
interface Props { food: Food; steps?: boolean }
const { food: f, steps = true } = Astro.props;
const v = freezeVerdict(f);
const pill = v.tone === "yes" ? "pill-yes" : v.tone === "no" ? "pill-no" : "pill-caution";
const showSteps = steps && v.tone !== "no";
---
<div class="flex flex-wrap items-center gap-3 mt-3.5"><span class:list={["pill", pill]}>{v.label}</span><span class="text-[15px] text-muted">{v.detail}</span></div>
{showSteps && <ol class="prose-list">{freezeStepsFor(f).map((s) => <li>{s}</li>)}</ol>}
{f.thawedFridge && <p class="mt-3 text-[15px] text-muted">After thawing in the fridge, use within {f.thawedFridge && ("min" in f.thawedFridge ? `${f.thawedFridge.min === f.thawedFridge.max ? f.thawedFridge.min : `${f.thawedFridge.min}–${f.thawedFridge.max}`} ${f.thawedFridge.unit}` : f.thawedFridge.text)}.</p>}
