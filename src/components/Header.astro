---
import Logo from "./Logo.astro";
import { type Locale, lurl } from "../lib/i18n";
const { L } = Astro.props as { L?: Locale };
const nav = L ? [
  { href: lurl.hubIndex(L), label: L.s.ui.foods },
  { href: lurl.method(L), label: L.s.ui.howWeVerify },
  { href: "/", label: L.s.ui.englishSite },
] : [
  { href: "/foods/", label: "Foods" },
  { href: "/tools/", label: "Calculators" },
  { href: "/can-you-freeze/", label: "Can you freeze it?" },
  { href: "/methodology/", label: "How we verify" },
];
const here = Astro.url.pathname;
---
<header class="sticky top-0 z-40 bg-white border-b border-line">
  <div class="container-site h-16 flex items-center gap-2">
    <a href={L ? lurl.home(L) : "/"} class="flex items-center gap-2.5 font-[650] text-[17px] mr-4 hover:text-ink">
      <Logo /><span>Gunther Heller</span>
    </a>
    <nav aria-label="Main" class="hidden md:flex items-center gap-0.5">
      {nav.map((n) => (
        <a href={n.href} class:list={["text-[15px] font-[450] px-3 py-[9px] rounded-[7px] hover:bg-tab hover:text-ink", n.href !== "/" && here.startsWith(n.href) && "bg-tab"]}>{n.label}</a>
      ))}
    </nav>
    <div class="flex-1"></div>
    {!L && <form action="/search/" method="get" role="search" class="hidden sm:block">
      <label for="site-q" class="sr-only-x">Search foods</label>
      <input id="site-q" name="q" type="search" placeholder="Search 660+ foods…" autocomplete="off"
        class="text-sm h-9 w-[260px] max-w-full border border-line rounded-lg px-3 outline-none focus:border-primary-soft" />
    </form>}
    {!L && <a href="/search/" aria-label="Search" class="sm:hidden w-11 h-11 border border-line rounded-lg grid place-items-center">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </a>}
    <details class="md:hidden relative">
      <summary aria-label="Menu" class="w-11 h-11 border border-line rounded-lg grid place-items-center">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <nav aria-label="Mobile" class="absolute right-0 top-12 w-60 bg-white border border-line rounded-[10px] p-2 grid">
        {nav.map((n) => <a href={n.href} class="px-3 py-2.5 rounded-lg hover:bg-tab text-[15px]">{n.label}</a>)}
      </nav>
    </details>
  </div>
</header>
