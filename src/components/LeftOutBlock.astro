---
import { type Food } from "../lib/data";
import { leftOutFor } from "../lib/content";
interface Props { food: Food }
const v = leftOutFor(Astro.props.food);
const pill = v.tone === "keep" ? "pill-yes" : v.tone === "discard" ? "pill-no" : "pill-caution";
---
<div class="mt-3.5 border border-line rounded-[10px] px-4 py-4 md:px-5 md:py-[18px] flex gap-4 items-start">
  <span class:list={["pill", pill]}>{v.label}</span>
  <p class="text-base">{v.text}</p>
</div>
