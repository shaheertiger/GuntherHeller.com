---
/**
 * /calories/{slug}/ — one food: calories, macro split, serving picker, Nutrition Facts (%DV),
 * vitamins & minerals, sugars, fats & fatty acids, amino acids; storage times when FoodKeeper covers it.
 */
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import NutrientTable from "./NutrientTable.astro";
import {
  type NFood, NFOODS, nfood, ncat, nurl, summary, servingLabel, pageTitle, pageDescription, per, fmtN, val, lcName, cap,
  MAIN, VITAMINS, MINERALS, SUGARS, FATS, AMINOS, OTHER, SOURCE_NAME, macroSplit, rankingsOf, rankingFor, servingLinks, servingUnits, NCATS,
} from "../lib/nutrition";
import { getFood, cellsFor, fmt, isNum, askFor } from "../lib/data";
import { freezeVerdict, leftOutFor, signsFor, storeTipsFor, methodsFor, quoteFor } from "../lib/content";
import { ORG, breadcrumbLd } from "../lib/schema";
import { SITE, abs } from "../lib/site";
import { existsSync } from "node:fs";

interface Props { food: NFood }
const { food } = Astro.props;
const path = nurl.food(food);
const cat = ncat(food.cat);
const S = summary(food);
const grams = S.s[1];
const m = macroSplit(food);
const name = food.name;
const lname = lcName(food);
const crumbs = [{ name: "Browse", href: nurl.browse() }, { name: cat.name, href: nurl.cat(cat.slug) }, { name }];

// Storage (FoodKeeper) for the foods it covers.
const sf = food.storage ? getFood(food.storage) : undefined;
const methods = sf ? methodsFor(sf) : [];
const freeze = sf ? freezeVerdict(sf) : null;
const leftOut = sf ? leftOutFor(sf) : null;
const signs = sf ? signsFor(sf).slice(0, 4) : [];
const tips = sf ? storeTipsFor(sf).slice(0, 4) : [];
const ask = sf ? askFor(sf) : [];
const pl = !!sf?.plural;
const Is = pl ? "Are" : "Is", Does = pl ? "do" : "does";

// Data-driven questions (each answer is computed from this food's numbers).
const per100 = (k: string) => val(food, k) ?? 0;
const netCarbsServing = per(Math.max(0, per100("205") - per100("291")), grams);
const keto = netCarbsServing <= 5 && m.carbs <= 10 ? "yes" : netCarbsServing <= 10 ? "in small amounts" : "no";
const faq: [string, string][] = [
  [`How many calories are in ${lname}?`, `${cap(servingLabel(S.s))} of ${lname} has ${S.kcal} calories. 100 g has ${Math.round(food.v.kcal)} calories.`],
  [`How much protein is in ${lname}?`, `${cap(servingLabel(S.s))} has ${fmtN(per(per100("203"), grams), "g")} of protein, which is ${m.protein}% of its calories.`],
  [`${Is} ${lname} keto-friendly?`, keto === "yes" ? `Yes. ${cap(servingLabel(S.s))} has ${fmtN(netCarbsServing, "g")} of net carbs, low enough for most keto plans (usually 20–50 g of net carbs a day).` : keto === "in small amounts" ? `In small amounts. ${cap(servingLabel(S.s))} has ${fmtN(netCarbsServing, "g")} of net carbs, so it takes a real share of a 20–50 g daily keto budget.` : `Not really. ${cap(servingLabel(S.s))} has ${fmtN(netCarbsServing, "g")} of net carbs, a large part of a 20–50 g daily keto budget.`],
];
if (sf) {
  const s0 = sf.states[0];
  const fr = cellsFor(sf, s0, 0).fridge.value;
  if (s0.fridge) faq.push([`How long ${Does} ${lname} last in the fridge?`, `${fr} at 40°F (4°C) or below, according to USDA FoodKeeper.`]);
  if (freeze) faq.push([`Can you freeze ${lname}?`, `${freeze.label}. ${freeze.detail}`]);
}
faq.push(...ask.slice(0, 6));

const similar = food.sim.map(nfood).filter((x): x is NFood => !!x).slice(0, 8);
const more = NFOODS.filter((x) => x.cat === food.cat && x.storage && x.slug !== food.slug && !food.sim.includes(x.slug)).slice(0, 6);

const title = pageTitle(food);
const description = pageDescription(food);
const fdcUrl = `https://fdc.nal.usda.gov/food-details/${food.id}/nutrients`;
const nutr = (k: string, u: string) => fmtN(per(per100(k), grams), u).replace(/^–$/, "0" + u);
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { ...ORG, "@context": undefined },
    { "@type": "WebPage", "@id": `${abs(path)}#page`, url: abs(path), name: title, description, isPartOf: { "@type": "WebSite", name: SITE.name, url: `${SITE.url}/` }, publisher: { "@id": ORG["@id"] }, dateModified: "2026-11-16", breadcrumb: breadcrumbLd(crumbs, path) },
    {
      "@type": "NutritionInformation",
      "@id": `${abs(path)}#nutrition`,
      name: `${name} nutrition facts`,
      servingSize: servingLabel(S.s),
      calories: `${S.kcal} calories`,
      fatContent: nutr("204", " g"),
      saturatedFatContent: nutr("606", " g"),
      transFatContent: nutr("605", " g"),
      cholesterolContent: nutr("601", " mg"),
      sodiumContent: nutr("307", " mg"),
      carbohydrateContent: nutr("205", " g"),
      fiberContent: nutr("291", " g"),
      sugarContent: nutr("269", " g"),
      proteinContent: nutr("203", " g"),
    },
    { "@type": "FAQPage", "@id": `${abs(path)}#faq`, mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
const img = sf && existsSync(`public/images/foods/${sf.slug}.webp`) ? { src: `/images/foods/${sf.slug}.webp`, src600: `/images/foods/${sf.slug}-600.webp`, w: 1200, h: 800, alt: `${name}` } : null;
const units = servingUnits(food);
const sLinks = servingLinks(food);
const ranks = rankingsOf(food).slice(0, 6);
const goodLinks = S.good.map((g) => ({ g, r: rankingFor(g.d.k) })).filter((x) => x.r);
const donut = `conic-gradient(var(--color-counter) 0 ${m.carbs}%, var(--color-primary) ${m.carbs}% ${m.carbs + m.fat}%, var(--color-fridge) ${m.carbs + m.fat}% 100%)`;
---
<Base title={title} description={description} path={path} jsonld={jsonld} ogType="article" ogImage={img ?? undefined}>
  <div class="container-site pt-6 max-w-[920px]">
    <Breadcrumb items={crumbs} />
    <div class="flex items-center gap-5 mt-4">
      {img && <img src={img.src600} srcset={`${img.src600} 600w, ${img.src} 1200w`} sizes="120px" width="120" height="80" alt={img.alt} class="rounded-[10px] object-cover w-[120px] h-[80px] shrink-0" fetchpriority="high" />}
      <div>
        <h1 class="h1-food">{name}</h1>
        <p class="text-muted mt-1 text-[15px]">{sf ? <>Nutrition shown for USDA “{food.desc}”</> : <>{SOURCE_NAME[food.src]} · FDC ID {food.id}</>}</p>
      </div>
    </div>

    <section class="card mt-6 p-5 md:p-6 grid gap-6 md:grid-cols-[180px_1fr] items-center" aria-labelledby="cal-h">
      <div class="grid place-items-center">
        <div class="donut" style={`background:${donut}`} role="img" aria-label={`${m.carbs}% carbs, ${m.fat}% fat, ${m.protein}% protein`}>
          <div class="donut-hole"><span class="text-[30px] font-[650] leading-none" data-kcal data-v100={food.v.kcal}>{S.kcal}</span><span class="text-[13px] text-muted">calories</span></div>
        </div>
      </div>
      <div>
        <h2 id="cal-h" class="sr-only-x">Calories in {lname}</h2>
        <ul class="list-none p-0 m-0 flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
          <li><span class="dot" style="background:var(--color-counter)"></span> Carbs <b>{m.carbs}%</b> · <span data-v100={per100("205")} data-unit="g">{fmtN(per(per100("205"), grams), "g")}</span></li>
          <li><span class="dot" style="background:var(--color-primary)"></span> Fat <b>{m.fat}%</b> · <span data-v100={per100("204")} data-unit="g">{fmtN(per(per100("204"), grams), "g")}</span></li>
          <li><span class="dot" style="background:var(--color-fridge)"></span> Protein <b>{m.protein}%</b> · <span data-v100={per100("203")} data-unit="g">{fmtN(per(per100("203"), grams), "g")}</span></li>
        </ul>
        <p class="mt-3 text-[16px]">{S.text}</p>
        {(ranks.length > 0 || goodLinks.length > 0) && (
          <p class="mt-3 text-[14px] text-muted">
            {ranks.length > 0 ? <>Ranks {ranks.map((x, i) => <>{i > 0 && ", "}<b>#{x.pos}</b> in <a class="link" href={nurl.rank(x.r)}>{x.r.h1.replace(/^F/, "f")}</a></>)}.</>
              : <>See {goodLinks.map((x, i) => <>{i > 0 && ", "}<a class="link" href={nurl.rank(x.r!)}>{x.r!.h1.replace(/^F/, "f")}</a></>)}.</>}
          </p>
        )}
      </div>
    </section>

    <form class="serving mt-5 flex flex-wrap items-end gap-3" data-serving onsubmit="return false">
      <label class="grid text-[13px] text-muted">Amount
        <input type="number" inputmode="decimal" min="0" step="any" value="1" name="amt" class="h-10 w-24 border border-line rounded-lg px-3 text-ink text-base" />
      </label>
      <label class="grid text-[13px] text-muted">Unit
        <select name="unit" class="h-10 border border-line rounded-lg px-2 text-ink text-base max-w-[340px]">
          {units.map(([l, g], i) => <option value={g} selected={i === 0}>{l === "g" || l === "oz" || l === "lb" ? l : `${l} (${g} g)`}</option>)}
        </select>
      </label>
      <p class="text-[13px] text-muted pb-2">Serving: <span data-serving-label>{servingLabel(S.s)}</span></p>
    </form>
    <nav aria-label={`Serving sizes of ${lname}`} class="mt-3">
      <h2 class="sr-only-x">Calories by serving size</h2>
      <ul class="list-none p-0 m-0 flex flex-wrap gap-1.5 text-[13px]">
        {sLinks.map((x) => <li><a href={`${path}?a=${x.a}`} class="pill bg-tab hover:bg-tint-lilac !text-[13px] !py-1 !px-2.5" data-a={x.a}>{x.label} · {x.kcal} cal</a></li>)}
      </ul>
    </nav>

    <section class="mt-8" aria-labelledby="facts-h">
      <h2 id="facts-h" class="text-[28px]">Nutrition Facts</h2>
      <p class="text-[14px] text-muted mt-1">For <span data-serving-label>{servingLabel(S.s)}</span> of {lname}. %DV is based on a 2,000-calorie diet.</p>
      <div class="mt-4 table-wrap">
        <table class="data-table ntable">
          <caption class="sr-only-x">Calories</caption>
          <tbody><tr class="kcal-row"><th scope="row">Calories</th><td class="num" data-v100={food.v.kcal} data-unit="kcal">{S.kcal}</td><td class="num"></td></tr></tbody>
        </table>
      </div>
      <div class="mt-2"><NutrientTable food={food} defs={MAIN} grams={grams} caption="Nutrition facts" showMissing indent={["606", "605", "net", "291", "269"]} /></div>
    </section>

    <div class="mt-10 grid gap-10 grid-cols-[minmax(0,1fr)]">
      <section aria-labelledby="vit-h">
        <h2 id="vit-h" class="text-[28px]">Vitamins and minerals</h2>
        <div class="mt-4 grid gap-4 grid-cols-[minmax(0,1fr)] md:grid-cols-2 items-start">
          <NutrientTable food={food} defs={VITAMINS} grams={grams} caption="Vitamins" />
          <NutrientTable food={food} defs={MINERALS} grams={grams} caption="Minerals" />
        </div>
      </section>
      {SUGARS.some((d) => val(food, d.k) != null) && (
        <section aria-labelledby="sug-h">
          <h2 id="sug-h" class="text-[28px]">Sugars and starch</h2>
          <div class="mt-4 max-w-[560px]"><NutrientTable food={food} defs={SUGARS} grams={grams} caption="Sugars" /></div>
        </section>
      )}
      <section aria-labelledby="fat-h">
        <h2 id="fat-h" class="text-[28px]">Fats and fatty acids</h2>
        <div class="mt-4 max-w-[560px]"><NutrientTable food={food} defs={FATS} grams={grams} caption="Fats" indent={["606", "645", "646", "605", "ala", "epa", "dpa", "dha"]} /></div>
      </section>
      {AMINOS.some((d) => val(food, d.k) != null) && (
        <section aria-labelledby="amino-h">
          <h2 id="amino-h" class="text-[28px]">Amino acids</h2>
          <div class="mt-4 max-w-[560px]"><NutrientTable food={food} defs={AMINOS} grams={grams} caption="Amino acids" /></div>
        </section>
      )}
      {OTHER.some((d) => val(food, d.k) != null) && (
        <section aria-labelledby="oth-h">
          <h2 id="oth-h" class="text-[28px]">Water, caffeine and alcohol</h2>
          <div class="mt-4 max-w-[560px]"><NutrientTable food={food} defs={OTHER} grams={grams} caption="Other" /></div>
        </section>
      )}

      {sf && (
        <section aria-labelledby="storage-h" id="storage">
          <h2 id="storage-h" class="text-[28px]">How long {Does} {lname} last?</h2>
          <p class="mt-3">{quoteFor(sf)}</p>
          <div class="table-wrap mt-4">
            <table class="data-table">
              <caption class="sr-only-x">Storage times for {lname}</caption>
              <thead><tr><th scope="col">Where</th><th scope="col">How long</th><th scope="col">Temperature</th><th scope="col">Note</th></tr></thead>
              <tbody>{methods.map((r) => <tr><th scope="row">{r.method}</th><td><b>{r.duration}</b></td><td>{r.temp}</td><td class="text-muted">{r.note}</td></tr>)}</tbody>
            </table>
          </div>
          <div class="grid gap-4 md:grid-cols-2 mt-5">
            {freeze && <div class="card p-4" id="freeze"><h3 class="text-[18px]">Can you freeze {lname}?</h3><p class="mt-2"><span class:list={["pill", `pill-${freeze.tone === "yes" ? "yes" : freeze.tone === "no" ? "no" : "caution"}`]}>{freeze.label}</span></p><p class="mt-2 text-[15px]">{freeze.detail}</p></div>}
            {leftOut && <div class="card p-4" id="leftout"><h3 class="text-[18px]">Left out overnight?</h3><p class="mt-2"><span class:list={["pill", leftOut.tone === "keep" ? "pill-yes" : leftOut.tone === "discard" ? "pill-no" : "pill-caution"]}>{leftOut.label}</span></p><p class="mt-2 text-[15px]">{leftOut.text}</p></div>}
          </div>
          <h3 class="text-[20px] mt-6" id="bad">How to tell if {lname} {pl ? "have" : "has"} gone bad</h3>
          <ul class="prose-list">{signs.map((s) => <li><b>{s.title}:</b> {s.text}</li>)}</ul>
          <h3 class="text-[20px] mt-6">How to store {lname}</h3>
          <ul class="prose-list">{tips.map((t) => <li>{t}</li>)}</ul>
          <p class="text-[13px] text-muted mt-3">Storage times: <a class="link" href="https://www.foodsafety.gov/keep-food-safe/foodkeeper-app" rel="nofollow">USDA FoodKeeper</a>. Freezer times are for quality; food kept at 0°F (-18°C) stays safe.</p>
        </section>
      )}

      <section aria-labelledby="faq-h">
        <h2 id="faq-h" class="text-[28px]">Questions about {lname}</h2>
        <div class="mt-4 grid gap-2">
          {faq.map(([q, a], i) => (
            <details class="card px-4 py-3" open={i < 2}>
              <summary class="font-[600]">{q}</summary>
              <p class="mt-2 text-[16px]">{a}</p>
            </details>
          ))}
        </div>
      </section>

      {similar.length > 0 && (
        <section aria-labelledby="sim-h">
          <h2 id="sim-h" class="text-[28px]">Similar foods</h2>
          <ul class="list-none p-0 m-0 mt-4 grid sm:grid-cols-2 gap-x-6">
            {[...similar, ...more].slice(0, 12).map((x) => (
              <li class="border-b border-line"><a href={nurl.food(x)} class="flex justify-between gap-4 py-2.5"><span>{x.name}</span><span class="text-muted text-sm whitespace-nowrap">{Math.round(x.v.kcal)} cal / 100 g</span></a></li>
            ))}
          </ul>
          <p class="mt-4 text-[15px]"><a class="link" href={nurl.cat(cat.slug)}>All {cat.name.toLowerCase()} ({cat.count})</a></p>
        </section>
      )}

      <p class="text-[13px] text-muted">Source: <a class="link" href={fdcUrl} rel="nofollow">{SOURCE_NAME[food.src]}, FDC ID {food.id}</a> (USDA Agricultural Research Service, public domain). Values per serving are calculated from the per-100 g data. General information, not medical or dietary advice.</p>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-serving]");
  if (form) {
    const amt = form.elements.namedItem("amt") as HTMLInputElement;
    const unit = form.elements.namedItem("unit") as HTMLSelectElement;
    const fmt = (x: number, u: string) => {
      if (u === "kcal") return String(Math.round(x));
      if (x === 0) return "0" + u;
      const a = Math.abs(x);
      const n = a >= 10 ? String(Math.round(x)) : a >= 0.1 ? String(+x.toFixed(1)) : String(+x.toFixed(2));
      return (n === "0" ? "<0.1" : n) + u;
    };
    const update = () => {
      const g = (parseFloat(amt.value) || 0) * parseFloat(unit.value);
      const opt = unit.options[unit.selectedIndex].text.replace(/\s*\([\d.]+ g\)$/, "").replace(/^1 /, "");
      const label = opt === "g" ? `${+g.toFixed(1)} g` : `${amt.value} ${opt} (${+g.toFixed(1)} g)`;
      document.querySelectorAll<HTMLElement>("[data-serving-label]").forEach((el) => (el.textContent = label));
      document.querySelectorAll<HTMLElement>("[data-v100]").forEach((el) => {
        const v = el.dataset.v100;
        if (v === "" || v == null) return;
        const x = (parseFloat(v) * g) / 100;
        if (el.dataset.dv) el.textContent = `${Math.round((x / parseFloat(el.dataset.dv)) * 100)}%`;
        else if (el.dataset.kcal != null) el.textContent = String(Math.round(x));
        else el.textContent = fmt(x, el.dataset.unit ?? "");
      });
    };
    amt.addEventListener("input", update);
    unit.addEventListener("change", update);
    const apply = (a: string | null) => {
      const m = a?.match(/^([\d.]+):(\d+)$/);
      if (!m || +m[2] >= unit.options.length) return;
      amt.value = String(+m[1]);
      unit.selectedIndex = +m[2];
      update();
    };
    apply(new URLSearchParams(location.search).get("a"));
    document.querySelectorAll<HTMLAnchorElement>("a[data-a]").forEach((el) =>
      el.addEventListener("click", (e) => { e.preventDefault(); history.replaceState(null, "", el.href); apply(el.dataset.a!); form.scrollIntoView({ behavior: "smooth", block: "start" }); }));
  }
</script>
