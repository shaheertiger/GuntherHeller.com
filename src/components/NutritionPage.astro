---
/**
 * /calories/{slug}/: how many calories one food has, and its nutrition facts. Nothing else.
 *
 *   H1 "How many calories are in {food}?" + one sentence with the number for the common serving and the macros
 *   1. calories by serving size (common servings + 100 g), with an amount/unit picker that rescales section 2
 *   2. the nutrition facts label (rows with no value or a zero value are left out)
 *   3. how it compares: rank in its category by calories per 100 g, and 3 similar foods
 *   4. vitamins and minerals (only those with a value)
 *   5. 3–5 questions answered from this food's own numbers
 *   6. sources (USDA FoodData Central with the FDC ID), a correction link, and one link to diagxcar.com for storage
 *
 * Every number comes from data/ (nutrition.json and friends). Nothing is estimated: a missing value is left out.
 */
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import Byline from "./Byline.astro";
import {
  type NFood, ncat, nurl, per, fmtN, val, lcName, cap, titleCase, MAIN, VITAMINS, MINERALS, OTHER, SOURCE_NAME, possessive, guideDate, chainOf,
  servings, commonServing, servingPhrase, kcalIn, pageTitle, pageH1, pageDescription, calorieRank, similarThree, pctDV, type NDef,
} from "../lib/nutrition";
import { foodDates } from "../lib/lastmod";
import { askFor, getFood } from "../lib/data";
import { ORG, breadcrumbLd } from "../lib/schema";
import { SITE, abs, reportHref } from "../lib/site";
import DIAGXCAR from "../../data/diagxcar.json";
import { existsSync } from "node:fs";

interface Props { food: NFood }
const { food } = Astro.props;
const path = nurl.food(food);
const cat = ncat(food.cat);
const name = food.name;
const lname = lcName(food);
const chain = chainOf(food);
const dates = foodDates(food);
/** "eggs" are plural, "cooked rice" is not: FoodKeeper's flag where we have it, else the name's last word. */
const plural = food.storage && getFood(food.storage) ? !!getFood(food.storage)!.plural : /[^s]s$/i.test(food.name.split(/[ ,(]/)[0]);
const Is = plural ? "Are" : "Is", does = plural ? "do" : "does", verbS = (v: string) => (plural ? v : `${v}s`);
const crumbs = [{ name: "Foods", href: nurl.browse() }, { name: cat.name, href: nurl.cat(cat.slug) }, { name }];

/* ---------------------------------------------------------------- numbers */
const v100 = (k: string) => val(food, k);
const S = servings(food);
const s0 = commonServing(food);
const g0 = s0.grams;
const amt = (k: string, grams: number, unit: string) => fmtN(per(v100(k) ?? 0, grams), unit);
const kcal0 = kcalIn(food, g0);
const has = (k: string) => v100(k) != null;
/** A value is shown only when the data has it and it does not round to zero for the common serving. */
const shows = (k: string, grams = g0) => { const x = v100(k); return x != null && x > 0 && fmtN(per(x, grams), "") !== "0"; };

/* ---------------------------------------------------------------- 1. lead + serving table */
// A zero-calorie food (water, salt) keeps its serving rows: "0 calories" is the answer. Its all-zero macro columns go.
const zeroCal = food.v.kcal === 0;
const macros = [["203", "protein"], ["205", "carbs"], ["204", "fat"]].filter(([k]) => has(k) && (!zeroCal || (v100(k) ?? 0) > 0));
const andList = (xs: string[]) => xs.join(", ").replace(/, ([^,]*)$/, " and $1");
const nonzero = macros.filter(([k]) => per(v100(k)!, g0) > 0), zero = macros.filter(([k]) => per(v100(k)!, g0) === 0);
const lead = `${cap(servingPhrase(food, s0))}${s0.label === "100 g" ? "" : ` (${+g0.toFixed(1)} g)`} has ${kcal0} calories${nonzero.length ? `, with ${andList(nonzero.map(([k, w]) => `${amt(k, g0, " g")} of ${w}`))}` : ""}${zero.length ? `${nonzero.length ? "," : ""} and no ${zero.map(([, w]) => w).join(" or ").replace(/ or ([^ ]*) or /, ", $1 or ")}` : ""}.`;
const rows = S.map((s) => ({ s, kcal: kcalIn(food, s.grams), cells: macros.map(([k]) => amt(k, s.grams, " g")) }))
  // A row with only zeros says nothing (water, plain tea): keep it only if calories or a macro is above zero.
  .filter((r) => zeroCal || r.kcal > 0 || r.cells.some((c) => !/^0 g$/.test(c)));
const pickUnits = [...S.filter((s) => s.label !== "100 g").map((s) => [s.label, s.grams] as const), ["g", 1] as const, ["oz", 28.35] as const];

/* ---------------------------------------------------------------- 2. label */
const LABEL_INDENT = new Set(["606", "605", "291", "269", "net"]);
const label = [...MAIN, ...OTHER.filter((d) => d.k === "262" || d.k === "221")].filter((d) => shows(d.k));
const dvCell = (d: NDef, grams: number) => { const p = pctDV(per(v100(d.k) ?? 0, grams), d); return p == null ? "" : `${p}%`; };

/* ---------------------------------------------------------------- 3. compare */
const rank = calorieRank(food);
const sims = similarThree(food);
const catLower = cat.name.toLowerCase();
const ord = (n: number) => `${n}${n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] ?? "th"}`;
const compareText = rank.of > 1
  ? `At ${Math.round(food.v.kcal)} calories per 100 g, ${lname} ${rank.pos === 1 ? `${plural ? "are" : "is"} the most calorie-dense of the ${rank.of} ${catLower} foods on this site` : rank.pos === rank.of ? `${plural ? "are" : "is"} the least calorie-dense of the ${rank.of} ${catLower} foods on this site` : `${verbS("rank")} ${ord(rank.pos)} of the ${rank.of} ${catLower} foods on this site, counting from the most calorie-dense`}.`
  : `${cap(lname)} ${plural ? "have" : "has"} ${Math.round(food.v.kcal)} calories per 100 g.`;

/* ---------------------------------------------------------------- 4. vitamins and minerals */
const inLabel = new Set(label.map((d) => d.k));
const seen = new Set<string>();
const micros = [...VITAMINS, ...MINERALS].filter((d) => d.unit !== "IU" && !inLabel.has(d.k) && !seen.has(d.k) && seen.add(d.k) && shows(d.k));

/* ---------------------------------------------------------------- 5. questions (answers computed from the numbers) */
const sp = servingPhrase(food, s0);
const q: [string, string][] = [];
if (has("203")) {
  const pg = per(v100("203")!, g0), pct = pctDV(pg, MAIN.find((d) => d.k === "203"));
  const share = kcal0 > 0 ? Math.round(((pg * 4) / kcal0) * 100) : null;
  const verdict = pct == null ? "" : pct >= 20 ? `Yes. That is ${pct}% of the Daily Value, which the FDA counts as high (20% or more).` : pct >= 10 ? `It is a good source: ${pct}% of the Daily Value (the FDA's bar for "good source" is 10–19%).` : `No. That is ${pct}% of the Daily Value, under the FDA's 10% bar for a good source.`;
  q.push([`${Is} ${lname} high in protein?`, pg === 0 ? `No. ${cap(sp)} has no protein.` : `${cap(sp)} has ${fmtN(pg, " g")} of protein${share != null && share > 0 && share <= 100 ? `, about ${share}% of its calories` : ""}. ${verdict}`.trim()]);
}
if (has("205")) {
  const c = per(v100("205")!, g0), fib = has("291") ? per(v100("291")!, g0) : null, sug = has("269") ? per(v100("269")!, g0) : null;
  const parts = [fib != null && fib > 0 ? `${fmtN(fib, " g")} of fiber` : "", sug != null && sug > 0 ? `${fmtN(sug, " g")} of sugar` : ""].filter(Boolean);
  q.push([`How many carbs are in ${lname}?`, c === 0 ? `${cap(sp)} has no carbohydrates.` : `${cap(sp)} has ${fmtN(c, " g")} of carbohydrates${parts.length ? `, including ${parts.join(" and ")}` : ""}${fib != null ? `; that leaves ${fmtN(Math.max(0, c - (fib ?? 0)), " g")} of net carbs` : ""}. 100 g has ${fmtN(v100("205"), " g")}.`]);
  if (fib != null) {
    const net = Math.max(0, c - fib);
    const carbShare = kcal0 > 0 ? (c * 4) / kcal0 : 1;
    q.push([`${Is} ${lname} keto-friendly?`, net <= 5 && carbShare <= 0.1 ? `In most keto plans, yes: ${sp} has ${fmtN(net, " g")} of net carbs, and keto diets usually allow 20–50 g a day.` : net <= 10 ? `In small amounts: ${sp} has ${fmtN(net, " g")} of net carbs, a real share of the 20–50 g a day that keto diets usually allow.` : `Not really: ${sp} has ${fmtN(net, " g")} of net carbs, a large part of the 20–50 g a day that keto diets usually allow.`]);
  }
}
if (has("204")) {
  const f = per(v100("204")!, g0), sat = has("606") ? per(v100("606")!, g0) : null;
  const pct = pctDV(f, MAIN.find((d) => d.k === "204"));
  q.push([`How much fat is in ${lname}?`, f === 0 ? `${cap(sp)} has no fat.` : `${cap(sp)} has ${fmtN(f, " g")} of fat${pct != null ? ` (${pct}% of the Daily Value)` : ""}${sat != null && sat > 0 ? `, of which ${fmtN(sat, " g")} is saturated` : ""}.`]);
}
// Hand-written questions, only the ones about nutrition (data/ask.json is mostly storage and safety, which is diagxcar's topic).
const NUTRITION_Q = /calor|protein|carb|sugar|fat\b|fiber|fibre|keto|vitamin|mineral|sodium|healthy|nutrition|diet/i;
const handWritten = food.storage ? askFor({ slug: food.storage }).filter(([qq]) => NUTRITION_Q.test(qq) && !/last|expire|go bad|fridge|shelf|freez|spoil|store/i.test(qq)) : [];
const faq = [...q, ...handWritten].slice(0, 5);

/* ---------------------------------------------------------------- 6. sources */
const fdcUrl = `https://fdc.nal.usda.gov/food-details/${food.id}/nutrients`;
const dx = food.storage && (DIAGXCAR.slugs as string[]).includes(food.storage) ? `https://diagxcar.com/food/${food.storage}/` : null;

/* ---------------------------------------------------------------- page */
const title = pageTitle(food);
const description = pageDescription(food);
const h1 = pageH1(food);
const img = food.storage && existsSync(`public/images/foods/${food.storage}.webp`) ? { src: `/images/foods/${food.storage}.webp`, src600: `/images/foods/${food.storage}-600.webp`, w: 1200, h: 800, alt: name } : null;
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    { ...ORG, "@context": undefined },
    {
      "@type": "Article",
      "@id": `${abs(path)}#article`,
      headline: h1,
      name: title,
      description,
      url: abs(path),
      mainEntityOfPage: abs(path),
      datePublished: dates.published,
      dateModified: dates.modified,
      author: { "@id": ORG["@id"] },
      publisher: { "@id": ORG["@id"] },
      about: { "@type": "Thing", name },
      isBasedOn: food.src === "R" && food.source ? food.source.url : fdcUrl,
      ...(img ? { image: abs(img.src) } : {}),
    },
    breadcrumbLd(crumbs, path),
    { "@type": "FAQPage", "@id": `${abs(path)}#faq`, mainEntity: faq.map(([qq, a]) => ({ "@type": "Question", name: qq, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<Base title={title} description={description} path={path} jsonld={jsonld} ogType="article" ogImage={img ?? undefined}>
  <article class="wrap pt-6 max-w-[880px]">
    <Breadcrumb items={crumbs} />
    <header class="food-head mt-4">
      {img && <img src={img.src600} srcset={`${img.src600} 600w, ${img.src} 1200w`} sizes="112px" width="112" height="75" alt={img.alt} class="food-thumb" fetchpriority="high" />}
      <div>
        <h1 class="h1x">{h1}</h1>
        <p class="food-answer">{lead}</p>
      </div>
    </header>
    <Byline path={path} updated={dates.modified} source={food.src === "R" ? `${possessive(chain?.name ?? "the chain")} nutrition guide` : `USDA FoodData Central, FDC ID ${food.id}`} />

    <section class="block-sec" aria-labelledby="serv-h">
      <h2 id="serv-h">Calories in {lname} by serving size</h2>
      <div class="tscroll mt-3">
        <table class="dtable serv-table">
          <caption class="vh">Calories, protein, carbs and fat in common servings of {lname}</caption>
          <thead><tr><th scope="col">Serving</th><th scope="col" class="num">Calories</th>{macros.map(([, w]) => <th scope="col" class="num">{cap(w)}</th>)}</tr></thead>
          <tbody>
            {rows.map((r) => <tr><th scope="row">{r.s.label}{r.s.label !== "100 g" && <span class="text-muted"> ({+r.s.grams.toFixed(1)} g)</span>}</th><td class="num"><b>{r.kcal}</b></td>{r.cells.map((c) => <td class="num">{c}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <form class="serving mt-4" data-serving onsubmit="return false">
        <label>Amount <input type="number" inputmode="decimal" min="0" step="any" value="1" name="amt" /></label>
        <label>Unit
          <select name="unit">{pickUnits.map(([l, g], i) => <option value={g} selected={i === 0}>{l === "g" || l === "oz" ? l : `${l} (${+g.toFixed(1)} g)`}</option>)}</select>
        </label>
        <p class="serving-out">= <b data-kcal data-v100={food.v.kcal}>{kcal0}</b> calories · label below shows <span data-serving-label>{s0.label === "100 g" ? "100 g" : `${s0.label} (${+g0.toFixed(1)} g)`}</span></p>
      </form>
    </section>

    {label.length > 0 && (
      <section class="block-sec" aria-labelledby="facts-h">
        <h2 id="facts-h">{cap(name)} nutrition facts</h2>
        <div class="nf-label mt-3">
          <p class="nf-serving">Serving size <span data-serving-label>{s0.label === "100 g" ? "100 g" : `${s0.label} (${+g0.toFixed(1)} g)`}</span></p>
          <p class="nf-kcal"><span>Calories</span><b data-kcal data-v100={food.v.kcal}>{kcal0}</b></p>
          <table class="nf-rows">
            <caption class="vh">Nutrition facts for {lname}</caption>
            <thead><tr><th scope="col">Nutrient</th><th scope="col" class="num">Amount</th><th scope="col" class="num">% Daily Value</th></tr></thead>
            <tbody>
              {label.map((d) => (
                <tr class:list={[LABEL_INDENT.has(d.k) && "sub"]}>
                  <th scope="row">{d.name}</th>
                  <td class="num" data-v100={v100(d.k)} data-unit={d.unit}>{amt(d.k, g0, d.unit)}</td>
                  <td class="num" data-v100={d.dv ? v100(d.k) : ""} data-dv={d.dv ?? ""}>{dvCell(d, g0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="nf-note">% Daily Value: how much a nutrient in one serving adds to a daily diet of 2,000 calories (FDA).</p>
        </div>
      </section>
    )}

    <section class="block-sec" aria-labelledby="cmp-h">
      <h2 id="cmp-h">How {does} {lname} compare?</h2>
      <p class="mt-3">{compareText} <a class="alink" href={nurl.cat(cat.slug)}>See all {catLower}</a>.</p>
      {sims.length > 0 && (
        <ul class="cmp-list">
          {sims.map((x) => { const sx = commonServing(x); return (
            <li><a href={nurl.food(x)}>{x.name}</a><span>{Math.round(x.v.kcal)} cal per 100 g{sx.label !== "100 g" && ` · ${kcalIn(x, sx.grams)} per ${sx.label}`}</span></li>
          ); })}
        </ul>
      )}
    </section>

    {micros.length > 0 && (
      <section class="block-sec" aria-labelledby="vit-h">
        <h2 id="vit-h">What vitamins and minerals are in {lname}?</h2>
        <p class="mt-2 text-[15px] text-muted">For <span data-serving-label>{s0.label === "100 g" ? "100 g" : `${s0.label} (${+g0.toFixed(1)} g)`}</span>. Nutrients USDA did not measure for this food are left out.</p>
        <div class="tscroll mt-3">
          <table class="dtable ntab">
            <caption class="vh">Vitamins and minerals in {lname}</caption>
            <thead><tr><th scope="col">Nutrient</th><th scope="col" class="num">Amount</th><th scope="col" class="num">% Daily Value</th></tr></thead>
            <tbody>{micros.map((d) => <tr><th scope="row">{d.name}</th><td class="num" data-v100={v100(d.k)} data-unit={d.unit}>{amt(d.k, g0, d.unit)}</td><td class="num" data-v100={d.dv ? v100(d.k) : ""} data-dv={d.dv ?? ""}>{dvCell(d, g0)}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}

    {faq.length > 0 && (
      <section class="block-sec" aria-labelledby="faq-h">
        <h2 id="faq-h">Questions about {lname}</h2>
        <div class="qa-list">
          {faq.map(([qq, a]) => <div class="qa"><h3>{qq}</h3><p>{a}</p></div>)}
        </div>
      </section>
    )}

    <section class="block-sec sources" aria-labelledby="src-h">
      <h2 id="src-h">Sources</h2>
      <ul>
        {food.src === "R" && food.source
          ? <li><a class="alink" href={food.source.url} rel="nofollow noopener">{food.source.name}</a>{food.source.date ? `, ${guideDate(food.source.date)}` : ""}: {possessive(chain?.name ?? "the chain")} own nutrition guide, values per serving as published.</li>
          : food.src === "B"
          ? <li><a class="alink" href={fdcUrl} rel="nofollow">USDA FoodData Central, FDC ID {food.id}</a>: the Nutrition Facts label {food.brand} submitted to USDA (Branded Foods), record “{food.desc}”{food.labelUpdated ? `, label dated ${guideDate(food.labelUpdated)}` : ""}. Other brands' recipes differ; the label on your jar wins.</li>
          : <li><a class="alink" href={fdcUrl} rel="nofollow">USDA FoodData Central, FDC ID {food.id}</a>: {SOURCE_NAME[food.src]}, record “{food.desc}”. Values per serving are worked out from USDA's per-100 g values and its household measures.</li>}
        <li>Daily Values: FDA, 21 CFR 101.9 (2,000-calorie diet).</li>
      </ul>
      <p class="mt-3">Spotted a wrong number? <a class="alink" href={reportHref(path)}>Report a correction</a> and we'll check it against the source. <a class="alink" href="/methodology/">How we build these pages</a>.</p>
      {dx && <p class="mt-3">How long {lname} {plural ? "keep" : "keeps"}: <a href={dx}>diagxcar.com</a>.</p>}
      <p class="mt-3 text-[13px] text-muted">General information, not medical or dietary advice.</p>
    </section>
  </article>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-serving]");
  if (form) {
    const amt = form.elements.namedItem("amt") as HTMLInputElement;
    const unit = form.elements.namedItem("unit") as HTMLSelectElement;
    const fmt = (x: number, u: string) => {
      if (u === "kcal") return String(Math.round(x));
      if (x === 0) return "0" + u;
      const a = Math.abs(x);
      const n = a >= 10 ? String(Math.round(x)) : a >= 0.1 ? String(+x.toFixed(1)) : String(+x.toFixed(2));
      return (n === "0" ? "<0.1" : n) + u;
    };
    const update = () => {
      const g = (parseFloat(amt.value) || 0) * parseFloat(unit.value);
      const opt = unit.options[unit.selectedIndex].text.replace(/\s*\([\d.]+ g\)$/, "");
      const label = opt === "g" ? `${+g.toFixed(1)} g` : `${amt.value} × ${opt} (${+g.toFixed(1)} g)`;
      document.querySelectorAll<HTMLElement>("[data-serving-label]").forEach((el) => (el.textContent = label));
      document.querySelectorAll<HTMLElement>("[data-v100]").forEach((el) => {
        const v = el.dataset.v100;
        if (v === "" || v == null) return;
        const x = (parseFloat(v) * g) / 100;
        if (el.dataset.dv) el.textContent = `${Math.round((x / parseFloat(el.dataset.dv)) * 100)}%`;
        else if (el.dataset.kcal != null) el.textContent = String(Math.round(x));
        else el.textContent = fmt(x, el.dataset.unit ?? "");
      });
    };
    amt.addEventListener("input", update);
    unit.addEventListener("change", update);
  }
</script>
