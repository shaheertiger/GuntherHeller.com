---
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import TrustBlock from "./TrustBlock.astro";
import { FOODS, type Food, url, lc, does, hasFreezePage, hasLeftOutPage, fmt, freezerFacts, primaryFridge } from "../lib/data";
import { freezeVerdict } from "../lib/content";
import { breadcrumbLd, ORG } from "../lib/schema";
import { abs } from "../lib/site";
import Fig from "./Fig.astro";
import FigSection from "./FigSection.astro";
import { figsFor } from "../figures/cards";

interface Props { kind: "freeze" | "bad" | "leftOut" }
const { kind } = Astro.props;
const cfg = {
  freeze: { path: "/can-you-freeze/", h1: "Can you freeze it?", title: "Can You Freeze It? Freezer Answers for {n} Foods, A–Z", desc: "Yes-or-no freezing answers for {n} foods, with how long each keeps its quality in the freezer and how to thaw it. USDA FoodKeeper data.", filter: hasFreezePage, href: url.freeze, q: (f: Food) => `Can you freeze ${lc(f)}?`, a: (f: Food) => { const v = freezeVerdict(f); const d = freezerFacts(f); return { tone: v.tone, text: v.tone === "no" ? "No" : `Yes${d && "min" in d ? ` · ${fmt(d)}` : ""}` }; } },
  bad: { path: "/does-it-go-bad/", h1: "Does it go bad?", title: "Does It Go Bad? Shelf Life & Spoilage Signs for {n} Foods", desc: "Does it expire? Shelf life and signs of spoilage for {n} foods, from honey and rice to milk and chicken, A–Z. USDA FoodKeeper data.", filter: (_: Food) => true, href: url.bad, q: (f: Food) => `${does(f)} ${lc(f)} go bad?`, a: (f: Food) => ({ tone: "neutral", text: primaryFridge(f) }) },
  leftOut: { path: "/left-out-overnight/", h1: "Left out overnight", title: "Food Left Out Overnight: Is It Safe? {n} Foods Checked", desc: "Left the chicken, rice or milk out overnight? The USDA 2-hour rule applied to {n} perishable foods, A–Z, with what to do next.", filter: hasLeftOutPage, href: url.leftOut, q: (f: Food) => `${lc(f).replace(/^./, (c) => c.toUpperCase())} left out overnight`, a: (_: Food) => ({ tone: "no", text: "Discard after 2 h" }) },
}[kind];
const foods = FOODS.filter(cfg.filter).sort((a, b) => a.name.localeCompare(b.name));
const groups = new Map<string, Food[]>();
for (const f of foods) {
  const L = /[a-z]/i.test(f.name[0]) ? f.name[0].toUpperCase() : "#";
  groups.set(L, [...(groups.get(L) ?? []), f]);
}
const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
const n = foods.length;
const crumbs = [{ name: "Home", href: "/" }, { name: cfg.h1 }];
const ld = { "@context": "https://schema.org", "@graph": [ORG, { "@type": "ItemList", name: cfg.h1, numberOfItems: n, itemListElement: foods.map((f, i) => ({ "@type": "ListItem", position: i + 1, name: cfg.q(f), url: abs(cfg.href(f)) })) }, breadcrumbLd(crumbs, cfg.path)] };
const pf = figsFor(cfg.path)!;
const others = [["/can-you-freeze/", "Can you freeze it?"], ["/does-it-go-bad/", "Does it go bad?"], ["/left-out-overnight/", "Left out overnight"]].filter(([h]) => h !== cfg.path);
---
<Base title={cfg.title.replace("{n}", String(n))} description={cfg.desc.replace("{n}", String(n))} path={cfg.path} jsonld={ld} figs={pf}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="eyebrow eyebrow-rule mt-5">Question hub · {n} answers</div>
    <h1 class="h1-food mt-3.5">{cfg.h1}</h1>
    <p class="lead mt-3 max-w-[680px]">{cfg.desc.replace("{n}", String(n))}</p>
    <Fig card={pf.hero} hero />
    {kind === "leftOut" && <p class="mt-4 max-w-[680px]">The rule is the same for every food here: perishable food is safe at room temperature for <strong>2 hours</strong>, or <strong>1 hour</strong> above 90°F (32°C). Overnight is always too long. Each page explains why for that food and how long it keeps once refrigerated.</p>}
    <FigSection id={kind === "leftOut" ? "rule" : "list"} title="At a glance" cards={pf.figures} />
    <nav aria-label="Jump to letter" class="sticky top-16 z-10 bg-white py-3 mt-6 border-b border-line flex flex-wrap gap-1">
      {letters.map((L) => groups.has(L) ? <a href={`#l-${L}`} class="w-8 h-8 grid place-items-center rounded-lg text-sm font-medium hover:bg-tab">{L}</a> : <span class="w-8 h-8 grid place-items-center text-sm text-faint" aria-hidden="true">{L}</span>)}
    </nav>
    {[...groups.entries()].map(([L, list]) => (
      <section id={`l-${L}`} class="mt-8">
        <h2 class="!text-[30px] !tracking-[-0.035em]">{L}</h2>
        <ul class="list-none p-0 mt-3 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6">
          {list.map((f) => { const a = cfg.a(f); return (
            <li class="border-b border-line"><a href={cfg.href(f)} class="flex justify-between gap-3 py-3 text-[15px]"><span>{cfg.q(f)}</span><span class:list={["shrink-0 text-[13px]", a.tone === "yes" ? "text-yes" : a.tone === "no" ? "text-no" : a.tone === "caution" ? "text-caution" : "text-muted"]}>{a.text}</span></a></li>
          ); })}
        </ul>
      </section>
    ))}
    <p class="mt-10 text-sm">Other question hubs: {others.map(([h, l], i) => <>{i > 0 && " · "}<a href={h} class="link">{l}</a></>)} · <a href="/foods/" class="link">All foods by category</a></p>
    <TrustBlock path={cfg.path} />
  </div>
</Base>
