---
import { type Food } from "../lib/data";
import { signsFor } from "../lib/content";
interface Props { food: Food }
const signs = signsFor(Astro.props.food);
---
<div class="grid sm:grid-cols-2 gap-3 md:gap-4 mt-[18px]">
  {signs.map((s) => (
    <div class="flex gap-3.5 p-3 md:p-4 border border-line rounded-[10px]">
      <div class="paper w-10 h-10 rounded-[10px] grid place-items-center shrink-0">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6b5f4a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon}/></svg>
      </div>
      <div><h3 class="!text-base !tracking-normal font-[650]">{s.title}</h3><p class="text-sm text-muted mt-0.5">{s.text}</p></div>
    </div>
  ))}
</div>
