---
interface Props { steps: string[]; label?: string }
const { steps, label = "Step" } = Astro.props;
---
<ol class="grid md:grid-cols-3 gap-3 list-none p-0 mt-4">
  {steps.map((s, i) => (
    <li class="soft p-4 bg-[#f7f8fb] border border-[#e8ecf5]">
      <div class="flex items-center gap-2"><span class="w-8 h-8 rounded-full grid place-items-center text-[15px] font-[650] text-white" style="background:#3c6fd1">{i + 1}</span><span class="text-[11px] font-bold uppercase tracking-[.08em] text-[#3c6fd1]">{label} {i + 1}</span></div>
      <p class="mt-2.5 text-[15px] leading-[1.55]">{s}</p>
    </li>
  ))}
</ol>
