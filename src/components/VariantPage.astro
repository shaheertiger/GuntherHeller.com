---
import Base from "../layouts/Base.astro";
import Breadcrumb from "./Breadcrumb.astro";
import AnswerCard from "./AnswerCard.astro";
import MiniAnswer from "./MiniAnswer.astro";
import Signs from "./Signs.astro";
import FreezeBlock from "./FreezeBlock.astro";
import LeftOutBlock from "./LeftOutBlock.astro";
import FoodCard from "./FoodCard.astro";
import Faq from "./Faq.astro";
import AdSlot from "./AdSlot.astro";
import TrustBlock from "./TrustBlock.astro";
import FoodImage from "./FoodImage.astro";
import QuickAnswer from "./fun/QuickAnswer.astro";
import DangerZone from "./fun/DangerZone.astro";
import { VIZ_EN } from "../lib/viz";
import { type Food, type Variant, url, getCategory, similarFoods, lc, does, titleCase, cap1, fmt, isNum, freezerFacts, cellsFor, hasFreezePage, hasLeftOutPage, primaryFridge, isAre, itThey } from "../lib/data";
import { freezeVerdict, freezeStepsFor, leftOutFor, datesFor, storeTipsFor, signsFor, groupOf, headline, thawVariantFor } from "../lib/content";
import { foodGraph } from "../lib/schema";
import { SITE } from "../lib/site";
import LongForm from "./LongForm.astro";
import Checker from "./fun/Checker.astro";
import Quiz from "./fun/Quiz.astro";
import Checklist from "./fun/Checklist.astro";
import { freezerChecks, counterChecks, quizFor, checklistFor } from "../lib/interactive";
import SectionHead from "./fun/SectionHead.astro";
import { faqExtraFor, freezeScienceFor, scenariosFor, datesExplained } from "../lib/longform";
import FridgeMap from "./fun/FridgeMap.astro";
import { zoneFor } from "../lib/content";
import { methodsFor, moldRuleFor, badScenariosFor, variantFaq, variantTitle, variantDescription } from "../lib/content";
import { modifierQA } from "../lib/content";
import Fig from "./Fig.astro";
import { figsFor } from "../figures/cards";

interface Props { food: Food; variant: Exclude<Variant, "food"> }
const { food: f, variant } = Astro.props;
const path = url[variant](f);
const cat = getCategory(f.category);
const name = lc(f);
const Name = titleCase(f.name);
const s0 = f.states[0];
const c0 = cellsFor(f, s0, 0);
const fz = freezerFacts(f);
const fv = freezeVerdict(f);
const lo = leftOutFor(f);
const hd = headline(f);
const them = itThey(f) === "they" ? "them" : "it";

const thaw = thawVariantFor(f);
const moldRule = moldRuleFor(f);
const badScenarios = badScenariosFor(f);

let h1 = "", title = "", description = "", quote = "", faq: [string, string][] = [];
if (variant === "freeze") {
  h1 = `Can You Freeze ${Name}?`;
  const ans = fv.tone === "no" ? "No" : "Yes";
  title = fz && isNum(fz) ? `Can You Freeze ${Name}? ${ans}, ${titleCase(fmt(fz)!)} [How to Freeze & Thaw]` : `Can You Freeze ${Name}? ${fv.tone === "no" ? "Not Recommended — Here's Why" : titleCase(fv.label)}`;
  description = fz && isNum(fz)
    ? `${ans}: ${name} ${f.plural ? "keep their" : "keeps its"} quality for ${fmt(fz)} in the freezer at 0°F. How to freeze ${them}, how to thaw ${them}, and how long ${itThey(f)} last${f.plural ? "" : "s"} after thawing.`
    : `${fv.detail} What to do instead, and how long ${name} ${f.plural ? "last" : "lasts"} in the fridge (${primaryFridge(f)}).`;
  quote = fz && isNum(fz)
    ? `${fv.tone === "caution" ? "Yes, with a texture trade-off" : "Yes"}: ${name} ${f.plural ? "keep" : "keeps"} ${fmt(fz)} in the freezer at 0°F (-18°C), compared with ${c0.fridge.value.toLowerCase()} in the fridge.`
    : `${fv.detail} Store ${them} in the fridge instead: ${c0.fridge.value.toLowerCase()}.`;
  faq = [
    [`How long can you freeze ${name}?`, fz && isNum(fz) ? `About ${fmt(fz)} for best quality at 0°F (-18°C). Kept frozen, it stays safe longer, but texture and flavour fade.` : fv.detail],
    [`How do you thaw frozen ${name}?`, `${thaw[0][1]}`],
    [`Can you refreeze ${name}?`, `Only if ${itThey(f)} ${f.plural ? "were" : "was"} thawed in the fridge and ${f.plural ? "have" : "has"} not been left out. Quality drops each time.`],
    [`Does freezing kill bacteria in ${name}?`, "No. Freezing pauses bacteria; they become active again as the food thaws. Cook or reheat to a safe temperature."],
  ];
} else if (variant === "bad") {
  h1 = `${does(f)} ${Name} Go Bad?`;
  title = `${does(f)} ${Name} Go Bad? How to Tell + Shelf Life (${titleCase(hd.value)} ${hd.where.replace(/^in the /, "")})`;
  description = `Yes, ${name} ${f.plural ? "go" : "goes"} bad: ${hd.value} ${hd.where.toLowerCase()}${fz && isNum(fz) ? `, ${fmt(fz)} frozen` : ""}. ${signsFor(f).slice(0, 2).map((s) => s.title).join(" and ")} are the first signs.`.slice(0, 155);
  quote = `Yes. ${f.name} ${f.plural ? "last" : "lasts"} ${hd.value} ${hd.where.toLowerCase()}${fz && isNum(fz) ? ` and ${fmt(fz)} in the freezer` : ""}. After that, or sooner if stored badly, ${itThey(f)} ${f.plural ? "spoil" : "spoils"}: watch for the signs below.`;
  const d = datesFor(f);
  faq = [
    [`How long does it take for ${name} to go bad?`, `${hd.value} ${hd.where.toLowerCase()}, per USDA FoodKeeper.${f.perishable ? " At room temperature, 2 hours." : ""}`],
    [`Can ${name} expire?`, d.unopened.text],
    [`What happens if you eat bad ${name}?`, f.perishable ? "Spoiled perishable food can cause food poisoning: nausea, vomiting, cramps or diarrhoea. See a doctor if symptoms are severe or last more than a few days." : "Usually an unpleasant taste rather than illness, but discard anything mouldy, rancid or smelling off."],
    [`How do you keep ${name} from going bad?`, storeTipsFor(f)[0]],
  ];
} else {
  h1 = `${Name} Left Out Overnight: Is It Safe?`;
  title = `${Name} Left Out Overnight? ${lo.tone === "discard" ? "Discard After 2 Hours" : "What to Do"} [USDA Rule]`;
  description = `${lo.tone === "discard" ? `No. ${f.name} left out more than 2 hours (1 hour above 90°F) should be thrown away.` : lo.text}`.slice(0, 150) + (lo.tone === "discard" ? " Why reheating won't save it." : "");
  quote = lo.text;
  faq = [
    [`How long can ${name} sit out?`, `No more than 2 hours at room temperature, or 1 hour above 90°F (32°C).`],
    [`Is ${name} left out overnight safe if I reheat ${them}?`, "No. Some bacteria make heat-stable toxins that reheating does not destroy. If in doubt, throw it out."],
    [`What if ${name} ${f.plural ? "were" : "was"} left out for 3 hours?`, "Past the 2-hour mark, discard it, even if it looks and smells fine."],
    [`How long ${does(f).toLowerCase()} ${name} last in the fridge?`, `${c0.fridge.value} at 40°F (4°C) or below, if refrigerated promptly.`],
  ];
}
{
  const extra = faqExtraFor(f);
  const pick = (re: RegExp) => extra.filter(([q]) => re.test(q));
  const more = variant === "freeze" ? pick(/temperature|container/) : variant === "bad" ? pick(/smell|container|temperature/) : pick(/smell|temperature/);
  const seen = new Set<string>();
  faq = [...faq, ...variantFaq(f, variant), ...more].filter(([q]) => !seen.has(q.toLowerCase()) && !!seen.add(q.toLowerCase()));
}
const qa = modifierQA(f);
const fzChecks = freezerChecks(f);
const ctChecks = counterChecks(f);
const quiz = quizFor(f);
title = variantTitle(f, variant, title);
description = variantDescription(f, variant, description);
if (description.length > 160) description = description.slice(0, 159).replace(/\s+\S*$/, "") + "…";

const crumbs = [{ name: "Home", href: "/" }, { name: cat.name, href: url.category(cat.slug) }, { name: f.name, href: url.food(f) }, { name: h1.replace(/\?$/, "") }];
const pf = figsFor(path)!;
const ld = foodGraph({ food: f, path, title, headline: h1, description, crumbs, faq, figures: [pf.hero, ...pf.figures] });
const similar = similarFoods(f, 4);
const sameQ = similarFoods(f, 10).filter((s) => s.slug !== f.slug && (variant === "bad" || (variant === "freeze" ? hasFreezePage(s) : hasLeftOutPage(s)))).slice(0, 8)
  .map((s) => ({ href: url[variant](s), label: variant === "freeze" ? `Can you freeze ${lc(s)}?` : variant === "bad" ? `${does(s)} ${lc(s)} go bad?` : `${cap1(lc(s))} left out overnight` }));
const hubFor = variant === "freeze" ? "/can-you-freeze/" : variant === "bad" ? "/does-it-go-bad/" : "/left-out-overnight/";
const siblings = [
  { href: url.food(f), label: `How long ${does(f).toLowerCase()} ${name} last? Full guide` },
  variant !== "freeze" && hasFreezePage(f) && { href: url.freeze(f), label: `Can you freeze ${name}?` },
  variant !== "bad" && { href: url.bad(f), label: `${does(f)} ${name} go bad?` },
  variant !== "leftOut" && hasLeftOutPage(f) && { href: url.leftOut(f), label: `${cap1(name)} left out overnight` },
].filter(Boolean) as { href: string; label: string }[];
const pill = (t: string) => (t === "yes" || t === "keep" ? "pill-yes" : t === "no" || t === "discard" ? "pill-no" : "pill-caution");
---
<Base title={title} description={description} path={path} jsonld={ld} ogType="article" ogImage={pf.hero}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="mt-3 md:mt-5">
      <h1 class="h1-food">{h1}</h1>
      <p class="mt-1.5 md:mt-2 text-sm md:text-[17px] text-muted">Source: USDA FoodKeeper and FSIS · last verified {SITE.verifiedLabel}</p>
      <Fig card={pf.hero} hero />
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-10 mt-4 md:mt-8 items-start">
      <article class="min-w-0 max-w-[820px]">
        {variant === "freeze" && (
          <section id="answer" class="border border-line rounded-[10px] p-5 md:p-6 grid sm:grid-cols-[auto_1fr] gap-4 sm:gap-8 items-center">
            <div>
              <div class="eyebrow"><span class="dot bg-freezer"></span>In the freezer</div>
              <div class="mt-2.5 text-[32px] md:text-[44px] font-[650] tracking-[-0.03em] leading-none">{fz ? fmt(fz) : "Not listed"}</div>
            </div>
            <div><span class:list={["pill", pill(fv.tone)]}>{fv.label}</span><p class="mt-2 text-[15px] text-muted">{fv.detail}</p></div>
          </section>
        )}
        {variant === "leftOut" && (
          <section id="answer" class="border border-line rounded-[10px] p-5 md:p-6 grid sm:grid-cols-[auto_1fr] gap-4 sm:gap-8 items-center">
            <div>
              <div class="eyebrow"><span class="dot bg-discard"></span>Room-temperature limit</div>
              <div class="mt-2.5 text-[32px] md:text-[44px] font-[650] tracking-[-0.03em] leading-none">2 hours</div>
              <div class="mt-1.5 text-sm text-muted">1 hour above 90°F (32°C)</div>
            </div>
            <div><span class:list={["pill", pill(lo.tone)]}>{lo.tone === "discard" ? "Overnight: discard" : lo.label}</span><p class="mt-2 text-[15px] text-muted">Food that sat out overnight has spent far longer than 2 hours in the danger zone (40–140°F).</p></div>
          </section>
        )}
        {variant === "bad" && <AnswerCard food={f} />}

        <QuickAnswer label={VIZ_EN.quick} text={quote} />

        {variant === "freeze" && (
          <>
            <section id="how-freeze" class="mt-8 md:mt-12">
              <h2 class="h2-food">How to freeze {name}</h2>
              <Fig cards={pf.at("how-freeze")} />
              {fv.tone === "no" ? <p class="mt-3.5">{fv.detail} Keep {them} in the fridge and use within {c0.fridge.value.toLowerCase()}.</p> : <ol class="prose-list">{freezeStepsFor(f).map((s) => <li>{s}</li>)}</ol>}
            </section>
            {fv.tone !== "no" && (
              <section id="how-thaw" class="mt-8 md:mt-12">
                <h2 class="h2-food">How to thaw {name}</h2>
              <Fig cards={pf.at("how-thaw")} />
                <div class="grid sm:grid-cols-3 gap-3 md:gap-4 mt-[18px]">
                  {thaw.map(([t, d]) => <div class="p-4 border border-line rounded-[10px]"><h3 class="!text-base !tracking-normal">{t}</h3><p class="text-sm text-muted mt-1">{d}</p></div>)}
                </div>
                <FreezeBlock food={f} steps={false} />
              </section>
            )}
            <section id="vs-compare" class="mt-8 md:mt-12">
              <h2 class="h2-food">Freezer vs fridge vs counter</h2>
              <Fig cards={pf.at("vs-compare")} />
              <div class="mt-[18px]"><AnswerCard food={f} id="compare" /></div>
            </section>
          </>
        )}

        {variant === "bad" && (
          <>
            <section id="how-tell" class="mt-8 md:mt-12">
              <h2 class="h2-food">How to tell if {name} {f.plural ? "are" : "is"} bad</h2>
              <Fig cards={pf.at("how-tell")} />
              <Signs food={f} />
            </section>
            <section id="past-date" class="mt-8 md:mt-12">
              <h2 class="h2-food">{cap1(name)} past the expiration date</h2>
              <Fig cards={pf.at("past-date")} />
              <div class="grid sm:grid-cols-2 gap-4 mt-[18px]">
                {[datesFor(f).unopened, datesFor(f).opened].map((d) => <div class="p-[18px] border border-line rounded-[10px]"><h3 class="!text-[17px] !tracking-normal">{d.title}</h3><p class="mt-1.5 text-[15px] text-muted">{d.text}</p></div>)}
              </div>
            </section>
            <section id="keep-fresh" class="mt-8 md:mt-12">
              <h2 class="h2-food">How to keep {name} fresh longer</h2>
              <Fig cards={pf.at("keep-fresh")} />
              <ul class="prose-list">{storeTipsFor(f).slice(0, 3).map((t) => <li>{t}</li>)}</ul>
            </section>
            <section id="mould" class="mt-8 md:mt-12">
              <h2 class="h2-food">{moldRule.q}</h2>
              <div class="mt-[18px] p-5 border border-line rounded-[10px]">
                <span class:list={["pill", moldRule.verdict === "discard" ? "pill-no" : "pill-caution"]}>{moldRule.label}</span>
                <p class="mt-2.5 text-[16px] leading-[1.7] text-[#3f3f46]">{moldRule.text}</p>
                <p class="mt-2 text-sm text-muted">Source: <a class="link" href="https://www.fsis.usda.gov/food-safety/safe-food-handling-and-preparation/food-safety-basics/molds-food-are-they-dangerous" rel="noopener">USDA FSIS, Molds on Food: Are They Dangerous?</a></p>
              </div>
            </section>
            <section id="still-ok" class="mt-8 md:mt-12">
              <h2 class="h2-food">Is {name} still OK to eat if…?</h2>
              <div class="grid sm:grid-cols-2 gap-3 mt-[18px]">{badScenarios.map(([t, d]) => <div class="soft p-4 border border-line"><h3 class="!text-base !tracking-normal">{t}</h3><p class="text-[15px] text-[#3f3f46] mt-1">{d}</p></div>)}</div>
            </section>
          </>
        )}

        {variant === "leftOut" && (
          <>
            <section id="verdict" class="mt-8 md:mt-12">
              <h2 class="h2-food">The verdict</h2>
              <Fig cards={pf.at("verdict")} />
              <LeftOutBlock food={f} />
              <DangerZone title={VIZ_EN.dangerZone} text={VIZ_EN.dangerText} cold={VIZ_EN.safeCold} hot={VIZ_EN.safeHot} />
            </section>
            <section id="by-temp" class="mt-8 md:mt-12">
              <h2 class="h2-food">How long {name} can sit out, by temperature</h2>
              <Fig cards={pf.at("by-temp")} />
              <div class="table-wrap mt-[18px]">
                <table class="data-table">
                  <thead><tr><th>Room temperature</th><th>Safe for</th><th>Then</th></tr></thead>
                  <tbody>
                    <tr><td class="font-medium">Below 40°F (4°C)</td><td>Refrigerated — {c0.fridge.value.toLowerCase()}</td><td class="text-muted">Use within the fridge window</td></tr>
                    <tr><td class="font-medium">40–90°F (4–32°C)</td><td>2 hours</td><td class="text-muted">Discard</td></tr>
                    <tr><td class="font-medium">Above 90°F (32°C)</td><td>1 hour</td><td class="text-muted">Discard</td></tr>
                    <tr><td class="font-medium">Overnight (8+ hours)</td><td>Not safe</td><td class="text-muted">Discard, even if reheated</td></tr>
                  </tbody>
                </table>
              </div>
            </section>
            <section id="store-safely" class="mt-8 md:mt-12">
              <h2 class="h2-food">Store {name} safely next time</h2>
              <Fig cards={pf.at("store-safely")} />
              <ul class="prose-list">{storeTipsFor(f).slice(0, 3).map((t) => <li>{t}</li>)}</ul>
              <p class="mt-3 text-sm"><a href="/tools/left-out-checker/" class="link">Check any food with the left-out checker →</a></p>
            </section>
          </>
        )}

        {variant === "freeze" && (
          <section id="freeze-science" class="mt-8 md:mt-12">
            <SectionHead icon="freezer" tint="var(--color-tint-blue)" ink="#2f5fbf" eyebrow="Inside the freezer">{`What freezing does to ${name}`}</SectionHead>
          <Fig cards={pf.at("freeze-science")} />
            <p class="soft mt-[18px] p-4 md:p-5 bg-[#f4f7fd] text-[16px] leading-[1.7] text-[#3f3f46]">{freezeScienceFor(f)}</p>
          </section>
        )}
        {variant === "leftOut" && (
          <section id="scenarios" class="mt-8 md:mt-12">
            <SectionHead icon="clock" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow="Real life">{`${cap1(name)} left out: common situations`}</SectionHead>
            <div class="grid sm:grid-cols-2 gap-3 mt-[18px]">{scenariosFor(f).map(([t, d]) => <div class="soft p-4 border border-line"><h3 class="!text-base !tracking-normal">{t}</h3><p class="text-[15px] text-[#3f3f46] mt-1">{d}</p></div>)}</div>
          </section>
        )}

        <section id="methods" class="mt-8 md:mt-12">
          <SectionHead icon="grid" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow="Every method">{`${cap1(name)} storage times by method`}</SectionHead>
          <Fig cards={pf.at("methods")} />
          <div class="table-wrap mt-[18px] !rounded-[20px]">
            <table class="data-table stack">
              <thead><tr><th>Method</th><th>Duration</th><th>Temperature</th><th>Container</th><th>Notes</th></tr></thead>
              <tbody>{methodsFor(f).map((m) => <tr><td class="font-medium full">{m.method}</td><td data-label="Duration">{m.duration}</td><td class="text-muted" data-label="Temperature">{m.temp}</td><td class="text-muted" data-label="Container">{m.container}</td><td class="text-muted full" data-label="Notes">{m.note}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        {variant === "bad" && <LongForm food={f} parts={["spoil"]} />}

        <section id="where" class="mt-8 md:mt-12">
          <SectionHead icon="fridge" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow="Where to keep it">{`Where to store ${name}`}</SectionHead>
          <Fig cards={pf.at("where")} />
          <FridgeMap zone={zoneFor(f).zone} why={zoneFor(f).why} names={{ door: "Door", top: "Top shelf", middle: "Middle shelf", bottom: "Bottom shelf", crisper: "Crisper drawer", pantry: "Pantry", freezer: "Freezer" }} />
        </section>


        {variant === "freeze" && fzChecks && (
          <section id="check" class="mt-8 md:mt-12">
            <SectionHead icon="freezer" tint="var(--color-tint-blue)" ink="#2f5fbf" eyebrow="Try it">{`How long has your ${name} been frozen?`}</SectionHead>
            <div class="mt-[18px]"><Checker id={`fz-${f.slug}`} ask="It's been in the freezer for…" options={fzChecks} note="Assumes -18°C (0°F) or colder. Frozen food stays safe; these verdicts are about quality." /></div>
          </section>
        )}
        {variant === "leftOut" && ctChecks && (
          <section id="check" class="mt-8 md:mt-12">
            <SectionHead icon="clock" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow="Try it">{`How long was your ${name} out?`}</SectionHead>
            <div class="mt-[18px]"><Checker id={`ct-${f.slug}`} ask="It's been out on the counter for…" options={ctChecks} note="Room temperature means anything above 4°C (40°F). On hot days above 32°C (90°F), the limit is 1 hour." /></div>
          </section>
        )}
        {variant === "bad" && (
          <section id="check" class="mt-8 md:mt-12">
            <SectionHead icon="nose" tint="var(--color-tint-pink)" ink="#b83269" eyebrow="Try it">{`Check your ${name}`}</SectionHead>
            <Checklist id={`cl-${f.slug}`} title="Tick anything you notice" items={checklistFor(f)} okText="Nothing ticked? Good sign. Still check how long it has been stored: the bacteria that cause food poisoning are invisible." badText="Any of these means it has gone bad. Throw it out — don't taste it to check." />
            {ctChecks && <div class="mt-3"><Checker id={`ct-${f.slug}`} ask={f.perishable ? "It's been out on the counter for…" : "It's been in the pantry for…"} options={ctChecks} /></div>}
          </section>
        )}



        <section class="mt-8 md:mt-12">
          <h2 class="h2-food">More about {name}</h2>
          <ul class="list-none p-0 mt-3.5 grid gap-2">{siblings.map((s) => <li><a href={s.href} class="link">{s.label} →</a></li>)}</ul>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 md:gap-3 mt-[18px]">{similar.map((s) => <FoodCard food={s} />)}</div>
          {sameQ.length > 0 && <><h3 class="mt-6 !text-[17px] !tracking-normal">Same question, similar foods</h3><ul class="list-none p-0 mt-2.5 grid sm:grid-cols-2 gap-2">{sameQ.map((s) => <li><a href={s.href} class="link">{s.label} →</a></li>)}</ul></>}
          <p class="mt-3.5 text-sm"><a href={hubFor} class="link">More {variant === "freeze" ? "“can you freeze it?”" : variant === "bad" ? "“does it go bad?”" : "“left out overnight”"} answers, A–Z →</a></p>
        </section>

        <section id="faq" class="mt-8 md:mt-12">
          <h2 class="h2-food">FAQ</h2>
          <Faq items={faq} />
        </section>

        <TrustBlock path={path} />
      </article>

      <aside class="hidden lg:grid sticky top-[90px] gap-5" aria-label="Summary">
        <MiniAnswer food={f} />
        <AdSlot w={300} h={250} id="variant-rail" />
      </aside>
    </div>
  </div>
</Base>
