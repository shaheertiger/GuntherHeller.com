---
import Icon from "./Icon.astro";
interface Props { title: string; text: string; links: { href: string; label: string; icon: string }[] }
const { title, text, links } = Astro.props;
---
<div class="soft p-5 md:p-7 mt-[18px] text-white" style="background:linear-gradient(135deg,#4a3bd2,#6b5ce7)">
  <div class="text-[22px] md:text-[26px] font-[650] tracking-[-0.02em]">{title}</div>
  <p class="text-[15px] text-[#e4e1fb] mt-1.5 max-w-[520px]">{text}</p>
  <div class="flex flex-wrap gap-2.5 mt-4">
    {links.map((l) => <a href={l.href} class="lift inline-flex items-center gap-2 rounded-full bg-white text-[#3f31c0] px-4 py-2.5 text-sm font-[650] hover:text-[#3f31c0]"><Icon name={l.icon} size={16} />{l.label}</a>)}
  </div>
</div>
