---
interface Props { tone: "keep" | "caution" | "discard"; labels: [string, string, string]; text: string }
const { tone, labels, text } = Astro.props;
const lights = [["keep", "#2f8f5b", labels[0]], ["caution", "#e0a326", labels[1]], ["discard", "#c0392b", labels[2]]] as const;
---
<div class="soft border border-line p-4 md:p-5 mt-3.5 grid sm:grid-cols-[auto_1fr] gap-4 sm:gap-6 items-center">
  <div class="flex sm:flex-col gap-2 rounded-[18px] bg-[#27272a] p-2.5 w-max" role="img" aria-label={labels[lights.findIndex((l) => l[0] === tone)]}>
    {lights.map(([k, c, l]) => (
      <div class="flex items-center gap-2 sm:gap-2.5 pr-2">
        <span class="w-7 h-7 rounded-full" style={k === tone ? `background:${c};box-shadow:0 0 0 3px ${c}55, 0 0 16px ${c}` : "background:#3f3f46"}></span>
        <span class:list={["text-[12px] font-[650]", k === tone ? "text-white" : "text-[#a1a1aa]"]}>{l}</span>
      </div>
    ))}
  </div>
  <p class="text-base">{text}</p>
</div>
