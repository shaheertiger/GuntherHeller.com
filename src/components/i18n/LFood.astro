---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../Breadcrumb.astro";
import Faq from "../Faq.astro";
import AdSlot from "../AdSlot.astro";
import LAnswerCard from "./LAnswerCard.astro";
import FoodImage from "../FoodImage.astro";
import SectionHead from "../fun/SectionHead.astro";
import QuickAnswer from "../fun/QuickAnswer.astro";
import Badges from "../fun/Badges.astro";
import Timeline from "../fun/Timeline.astro";
import PerishScale from "../fun/PerishScale.astro";
import StillGood from "../fun/StillGood.astro";
import TrafficLight from "../fun/TrafficLight.astro";
import DangerZone from "../fun/DangerZone.astro";
import Signs from "../Signs.astro";
import Steps from "../Steps.astro";
import Icon from "../fun/Icon.astro";
import LongFormL from "./LongFormL.astro";
import Checker from "../fun/Checker.astro";
import Quiz from "../fun/Quiz.astro";
import Checklist from "../fun/Checklist.astro";
import { widgetsL } from "../../lib/interactiveL";
import { longL } from "../../lib/longformL";
import { timelineBars, perishLevel, checker, type VizStrings } from "../../lib/viz";
import { type Food, getCategory, url as enUrl, cellsFor } from "../../lib/data";
import { groupOf } from "../../lib/content";
import { type Locale, foodCopy, methodsL, freezeL, leftOutL, faqL, similarL, lurl, foodAlternates, verifiedDate, fill, ft, cellsL, stateLabel, fmtL } from "../../lib/i18n";
import { ORG, breadcrumbLd, faqLd } from "../../lib/schema";
import { SITE, abs, reportHref } from "../../lib/site";
import Fig from "../Fig.astro";
import { figsFor } from "../../figures/cards";
import { imageLd } from "../../lib/schema";

interface Props { L: Locale; food: Food }
const { L, food: f } = Astro.props;
const S = L.s, U = S.ui, F = S.food;
const path = lurl.food(L, f);
const { T, h1, title, description, quote } = foodCopy(L, f);
const date = verifiedDate(L);
const catName = S.categories[f.category];
const crumbs = [{ name: U.home, href: lurl.home(L) }, { name: catName, href: lurl.hub(L, f.category) }, { name: T.n }];
const methods = methodsL(L, f);
const z = freezeL(L, f);
const lo = leftOutL(L, f);
const lf = longL(L, f);
const wi = widgetsL(L, f);
const faq = [...faqL(L, f), ...(lf ? lf.faq : [])];
const signs = S.signs[groupOf(f)] as [string, string][];
const store = S.store[groupOf(f)] as string[];
const similar = similarL(L, f);
const pill = (tone: string) => (tone === "yes" || tone === "keep" ? "pill-yes" : tone === "no" || tone === "discard" ? "pill-no" : "pill-caution");
const ICONS = ["M12 3a7 7 0 017 7c0 5-7 11-7 11S5 15 5 10a7 7 0 017-7z", "M4 12h16M4 7h16M4 17h16", "M12 21a9 9 0 110-18 9 9 0 010 18z", "M12 9v4M12 17h.01M10.3 3.9L2.5 17a2 2 0 001.7 3h15.6a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"];
const V = S.viz as VizStrings;
const E = (S.viz as any).eyebrows;
const c0 = cellsL(L, f, f.states[0], 0);
const fzi = f.states.findIndex((s) => s.freezer);
const fzValue = fzi >= 0 ? cellsL(L, f, f.states[fzi], fzi).freezer.value : c0.freezer.value;
const bars = timelineBars(f);
const checks = checker(f);
const badges = [
  f.perishable ? { label: V.badges.perishable, tone: "red" as const } : f.states[0].pantry ? { label: V.badges.shelf, tone: "green" as const } : null,
  z.tone === "yes" ? { label: V.badges.freezes, tone: "blue" as const } : z.tone === "no" ? { label: V.badges.noFreeze, tone: "amber" as const } : null,
  f.states.some((s) => s.key === "opened") ? { label: V.badges.opened, tone: "lilac" as const } : null,
].filter((b): b is NonNullable<typeof b> => !!b);
const TIP_ICONS = ["fridge", "box", "thermo", "calendar", "leaf"];
const values = f.states.flatMap((s, i) => { const c = cellsL(L, f, s, i); const tag = s.label ? ` (${stateLabel(L, s)})` : ""; return [[U.onCounter + tag, c.pantry.value], [U.inFridge + tag, c.fridge.value], [U.inFreezer + tag, c.freezer.value]].map(([name, value]) => ({ "@type": "PropertyValue", name, value })); });
const pf = figsFor(path)!;
const figs = [pf.hero, ...pf.figures];
const ld = { "@context": "https://schema.org", "@graph": [ORG,
  { "@type": "Article", headline: h1, description, url: abs(path), inLanguage: S.htmlLang, image: { "@id": `${abs(path)}#fig-${pf.hero.id}` }, datePublished: SITE.verifiedISO, dateModified: SITE.verifiedISO, author: { "@id": ORG["@id"] }, publisher: { "@id": ORG["@id"] }, about: { "@type": "Thing", name: T.n }, translationOfWork: { "@id": `${abs(enUrl.food(f))}#article` } },
  { "@type": "Dataset", name: T.n, url: abs(path), inLanguage: S.htmlLang, license: "https://creativecommons.org/publicdomain/zero/1.0/", isAccessibleForFree: true, creator: { "@type": "Organization", name: "USDA Food Safety and Inspection Service" }, isBasedOn: f.source.url, dateModified: SITE.verifiedISO, variableMeasured: values, image: figs.map((c) => ({ "@id": `${abs(path)}#fig-${c.id}` })) },
  ...imageLd(abs(path), figs), breadcrumbLd(crumbs, path), faqLd(faq)] };
---
<Base title={title} description={description} path={path} jsonld={ld} ogType="article" alternates={foodAlternates(f)} L={L} ogImage={pf.hero}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <div class="mt-3 md:mt-5">
      <div>
        <h1 class="h1-food hyphens-auto">{h1}</h1>
        <p class="mt-1.5 md:mt-2 text-sm md:text-[17px] text-muted">{U.subline.replace("{date}", date)} · <a href={lurl.method(L)} class="link">{U.howWeVerify} →</a></p>
        <Badges items={badges} />
        <Fig card={pf.hero} hero />
      </div>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,1fr)_300px] gap-10 mt-4 md:mt-8 items-start">
      <article class="min-w-0 max-w-[820px]">
        <LAnswerCard L={L} food={f} />
        {quote && <QuickAnswer label={V.quick} text={quote} />}

        {bars.length > 0 && (
          <section id="glance" class="mt-8 md:mt-12">
            <SectionHead icon="scale" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow={E.glance}>{V.glance}</SectionHead>
            <Timeline bars={bars} labels={{ pantry: U.counter, fridge: U.fridge, freezer: U.freezer }} values={{ pantry: c0.pantry.value, fridge: c0.fridge.value, freezer: fzValue }} ticks={V.ticks} note={V.glanceNote} plus={V.plus} />
            <div class="grid gap-3 mt-3">
              <PerishScale level={perishLevel(f)} title={V.perish} levels={V.levels} note={V.levelNote} />
              {checks && <StillGood checks={checks} V={V} units={S.units} id={`sg-${L.code}-${f.slug}`} />}
            </div>
          </section>
        )}

        {wi && (wi.counter || wi.freezer) && (
          <section id="check" class="mt-8 md:mt-12">
            <SectionHead icon="clock" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow={wi.W.eyebrow}>{wi.hCheck}</SectionHead>
            <div class="grid gap-3 mt-[18px]">
              {wi.counter && <Checker id={`ct-${L.code}-${f.slug}`} ask={wi.counter.ask} hint={wi.W.hint} note={wi.counter.note} options={wi.counter.options} />}
              {wi.freezer && <Checker id={`fz-${L.code}-${f.slug}`} ask={wi.freezer.ask} hint={wi.W.hint} note={wi.freezer.note} options={wi.freezer.options} />}
            </div>
          </section>
        )}

        <LongFormL lf={lf} part="about" />

        <section id="methods" class="mt-8 md:mt-12">
          <SectionHead icon="grid" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow={E.methods}>{F.hMethods}</SectionHead>
          <Fig cards={pf.at("methods")} />
          <div class="table-wrap mt-[18px] !rounded-[20px]">
            <table class="data-table stack">
              <thead><tr><th>{F.thMethod}</th><th>{F.thDuration}</th><th>{F.thTemp}</th><th>{F.thNotes}</th></tr></thead>
              <tbody>{methods.map((m) => <tr><td class="font-medium full">{m.method}</td><td data-label={F.thDuration}>{m.duration}</td><td class="text-muted" data-label={F.thTemp}>{m.temp}</td><td class="text-muted" data-label={F.thNotes}>{m.note}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        <AdSlot w={300} h={250} class="lg:hidden mt-8" id="l-food-mobile" label={L.s.ui.advert} />

        <section id="bad" class="mt-8 md:mt-12">
          <SectionHead icon="nose" tint="var(--color-tint-pink)" ink="#b83269" eyebrow={E.signs}>{F.hSigns}</SectionHead>
          <Fig cards={pf.at("bad")} />
          <Signs signs={signs.map(([title, text]) => ({ title, text }))} />
          {wi && <Checklist id={`cl-${L.code}-${f.slug}`} title={wi.W.checklist.title} items={wi.checklist} okText={wi.W.checklist.ok} badText={wi.W.checklist.bad} />}
        </section>

        <LongFormL lf={lf} part="where" />
        <LongFormL lf={lf} part="qa" />
        <LongFormL lf={lf} part="spoil" />

        <section id="freeze" class="mt-8 md:mt-12">
          <SectionHead icon="freezer" tint="var(--color-tint-blue)" ink="#2f5fbf" eyebrow={E.freeze}>{fill(F.hFreeze, {}, T)}</SectionHead>
          <Fig cards={pf.at("freeze")} />
          <div class="soft mt-3.5 p-4 md:p-5 flex flex-wrap items-center gap-3" style={`background:${z.tone === "no" ? "var(--color-tint-red)" : z.tone === "yes" ? "var(--color-tint-blue)" : "var(--color-tint-amber)"}`}><span class="w-10 h-10 rounded-[14px] bg-white grid place-items-center" style={`color:${z.tone === "no" ? "#c0392b" : "#3c6fd1"}`}><Icon name="freezer" size={20} /></span><span class:list={["pill bg-white", z.tone === "no" ? "!text-no" : z.tone === "yes" ? "!text-[#2c56a8]" : "!text-caution"]}>{z.label}</span><span class="text-[15px] text-[#3f3f46] flex-1 min-w-[220px]">{z.detail}</span></div>
          {z.steps.length > 0 && <Steps steps={z.steps} label={V.steps} />}
          {f.thawedFridge && <p class="mt-3 text-[15px] text-muted">{S.freeze.afterThaw.replace("{d}", fmtL(L, f.thawedFridge)!)}</p>}
        </section>

        <section id="leftout" class="mt-8 md:mt-12">
          <SectionHead icon="clock" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow={E.leftOut}>{F.hLeftOut}</SectionHead>
          <Fig cards={pf.at("leftout")} />
          <TrafficLight tone={lo.tone} labels={[S.leftOut.keep, S.leftOut.check, S.leftOut.discard]} text={lo.text} />
          {f.perishable && <DangerZone title={V.dangerZone} text={V.dangerText} cold={V.safeCold} hot={V.safeHot} />}
        </section>

        <section id="store" class="mt-8 md:mt-12">
          <SectionHead icon="fridge" tint="var(--color-tint-green)" ink="#1b7a55" eyebrow={E.tips}>{F.hStore}</SectionHead>
          <Fig cards={pf.at("store")} />
          <ul class="grid sm:grid-cols-2 gap-3 list-none p-0 mt-4">{store.map((t, i) => (
            <li class="lift soft flex gap-3 p-4 border border-line"><span class="icon-chip" style="background:var(--color-tint-green);color:#1b7a55"><Icon name={TIP_ICONS[i % TIP_ICONS.length]} size={17} /></span><span class="text-[15px] leading-[1.55]">{t}</span></li>
          ))}</ul>
        </section>

        <LongFormL lf={lf} part="buying" />
        <LongFormL lf={lf} part="dates" />

        <section id="similar" class="mt-8 md:mt-12">
          <SectionHead icon="leaf" tint="var(--color-tint-amber)" ink="#8a5a0c" eyebrow={E.similar}>{U.similar}</SectionHead>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 md:gap-3 mt-[18px]">
            {similar.map((s) => <a href={s.href} class="lift block p-2 md:p-2.5 border border-line rounded-[18px] min-h-11 hover:border-[#c9c9cf] bg-white"><FoodImage food={s.f} alt="" class="mb-2" /><div class="font-medium text-[15px] leading-snug px-1">{s.name}</div><div class="text-[13px] text-muted mt-0.5 px-1 pb-1">{U.fridge}: {s.fridge}</div></a>)}
          </div>
          <p class="mt-3.5 text-sm"><a href={lurl.hub(L, f.category)} class="link">{U.allIn.replace("{cat}", catName)} →</a> · <a href={enUrl.food(f)} hreflang="en" lang="en" class="link">{U.readInEnglish} →</a></p>
        </section>

        {wi && (
          <section id="quiz" class="mt-8 md:mt-12">
            <SectionHead icon="spark" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow={wi.W.quiz.eyebrow}>{wi.hQuiz}</SectionHead>
            <Quiz id={`qz-${L.code}-${f.slug}`} items={wi.quiz} labels={wi.quizLabels} />
          </section>
        )}

        <section id="faq" class="mt-8 md:mt-12">
          <SectionHead icon="question" tint="var(--color-tint-lilac)" ink="#4a3bd2" eyebrow={E.faq}>{F.hFaq}</SectionHead>
          <Faq items={faq} />
        </section>

        <div class="mt-12 px-5 py-[18px] bg-panel rounded-[10px] text-sm text-muted flex flex-wrap justify-between gap-4">
          <span>{U.trust.replace("{source}", "USDA FoodKeeper").replace("{date}", date)}</span>
          <span><a href={lurl.method(L)} class="link">{U.howWeVerifyLong}</a> · <a href={reportHref(path)} class="link">{U.report}</a></span>
        </div>
      </article>
      <aside class="hidden lg:grid sticky top-[90px] gap-5" aria-label={T.n}>
        <div class="border border-line rounded-[10px] p-4">
          <div class="eyebrow">{T.n}</div>
          <dl class="grid gap-2 mt-2.5 text-sm m-0">
            {(() => { const c = cellsL(L, f, f.states[0], 0); return [[U.counter, c.pantry.value], [U.fridge, c.fridge.value], [U.freezer, c.freezer.value]].map(([k, v]) => <div class="flex justify-between gap-3"><dt class="text-muted">{k}</dt><dd class="m-0 font-medium text-right">{v}</dd></div>); })()}
          </dl>
        </div>
        <AdSlot w={300} h={250} id="l-food-rail" label={L.s.ui.advert} />
      </aside>
    </div>
  </div>
</Base>
