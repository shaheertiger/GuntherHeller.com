---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, abs } from "../lib/site";
import type { Alt, Locale } from "../lib/i18n";
import Analytics from "@vercel/analytics/astro";
import type { PageFigs } from "../figures/cards";
import { imageLd } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object | object[];
  noindex?: boolean;
  ogType?: "website" | "article";
  /** hreflang cluster (English first). Omit for English-only pages. */
  alternates?: Alt[];
  /** Set on localized pages. */
  L?: Locale;
  /** The page's hero figure; becomes og:image / twitter:image. */
  ogImage?: { src: string; w: number; h: number; alt: string };
  /** All of the page's generated figures: hero → og:image; ImageObjects are added to the JSON-LD graph. */
  figs?: PageFigs | null;
}
const { title, description, path, jsonld, noindex = false, ogType = "website", alternates, L, figs } = Astro.props;
const ogImage = Astro.props.ogImage ?? figs?.hero;
const htmlLang = L?.s.htmlLang ?? "en";
const alts = alternates && alternates.length > 1 ? alternates : [{ lang: "en", href: path }];
const gsv = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bsv = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const xDefault = alts.find((a) => a.lang === "en")?.href ?? path;
const canonical = abs(path);
const og = abs(ogImage?.src ?? SITE.ogImage);
const ld: any[] = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
if (figs && ld[0]) {
  const nodes = imageLd(canonical, [figs.hero, ...figs.figures]);
  const g = ld[0]["@graph"];
  if (Array.isArray(g)) { const have = new Set(g.map((x: any) => x["@id"])); g.push(...nodes.filter((n) => !have.has(n["@id"]))); }
  else ld[0] = { "@context": "https://schema.org", "@graph": [{ ...ld[0], "@context": undefined, image: { "@id": nodes[0]["@id"] } }, ...nodes] };
}
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (GTM-KMS824N3) -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KMS824N3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <!-- Google AdSense (ca-pub-2128579868272786) -->
    <meta name="google-adsense-account" content="ca-pub-2128579868272786" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2128579868272786" crossorigin="anonymous"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical} />
    {!noindex && alts.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    <link rel="preload" href="/fonts/dm-sans-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    {gsv && path === "/" && <meta name="google-site-verification" content={gsv} />}
    {bsv && path === "/" && <meta name="msvalidate.01" content={bsv} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={(L?.s.locale ?? "en-US").replace("-", "_")} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content={String(ogImage?.w ?? 1200)} />
    <meta property="og:image:height" content={String(ogImage?.h ?? 630)} />
    <meta property="og:image:alt" content={ogImage?.alt ?? "Gunther Heller — how long food lasts in the fridge, freezer and pantry"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x).replace(/</g, "\\u003c")} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">{L ? L.s.ui.skip : "Skip to content"}</a>
    <Header L={L} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer L={L} alternates={alternates} />
    <Analytics />
  </body>
</html>
