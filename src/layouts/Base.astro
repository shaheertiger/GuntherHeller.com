---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, abs } from "../lib/site";
import type { Alt, Locale } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object | object[];
  noindex?: boolean;
  ogType?: "website" | "article";
  /** hreflang cluster (English first). Omit for English-only pages. */
  alternates?: Alt[];
  /** Set on localized pages. */
  L?: Locale;
}
const { title, description, path, jsonld, noindex = false, ogType = "website", alternates, L } = Astro.props;
const htmlLang = L?.s.htmlLang ?? "en";
const alts = alternates && alternates.length > 1 ? alternates : [{ lang: "en", href: path }];
const xDefault = alts.find((a) => a.lang === "en")?.href ?? path;
const canonical = abs(path);
const og = abs(SITE.ogImage);
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical} />
    {!noindex && alts.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    <link rel="preload" href="/fonts/dm-sans-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={(L?.s.locale ?? "en-US").replace("-", "_")} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gunther Heller — how long food lasts in the fridge, freezer and pantry" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x).replace(/</g, "\\u003c")} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">{L ? L.s.ui.skip : "Skip to content"}</a>
    <Header L={L} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer L={L} alternates={alternates} />
  </body>
</html>
