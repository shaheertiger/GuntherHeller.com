---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, abs } from "../lib/site";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object | object[];
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: { src: string; w: number; h: number; alt: string };
  /** Article pages: dates and section for the article:* Open Graph tags. */
  article?: { published: string; modified: string; section?: string };
}
const { title, description, path, jsonld, noindex = false, ogType = "website", ogImage, article } = Astro.props;
const gsv = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bsv = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const canonical = abs(path);
const og = abs(ogImage?.src ?? SITE.ogImage);
const ld: any[] = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (GTM-KMS824N3) -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KMS824N3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <!-- Google AdSense (ca-pub-2128579868272786) -->
    <meta name="google-adsense-account" content="ca-pub-2128579868272786" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2128579868272786" crossorigin="anonymous"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/dm-sans-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    {gsv && path === "/" && <meta name="google-site-verification" content={gsv} />}
    {bsv && path === "/" && <meta name="msvalidate.01" content={bsv} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content={String(ogImage?.w ?? 1200)} />
    <meta property="og:image:height" content={String(ogImage?.h ?? 630)} />
    <meta property="og:image:alt" content={ogImage?.alt ?? "Gunther Heller — calories and nutrition facts for every food"} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article && <meta property="article:opinion" content="false" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x).replace(/</g, "\\u003c")} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
