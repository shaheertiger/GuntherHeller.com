---
import Base from "../layouts/Base.astro";
---
<Base title="Page Not Found | Gunther Heller" description="This page does not exist." path="/404/" noindex>
  <div class="container-site pt-12 max-w-[760px]">
    <h1 class="h1-food">Page not found</h1>
    <p class="lead mt-3">Search 13,000+ foods or <a class="link" href="/food/">browse by category</a>.</p>
    <form action="/search/" method="get" class="mt-6 flex gap-2" role="search"><input name="q" type="search" class="flex-1 h-11 border border-line rounded-lg px-3" aria-label="Search foods" /><button class="btn-primary">Search</button></form>
  </div>
</Base>
