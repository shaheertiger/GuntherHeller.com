---
import Prose from "../layouts/Prose.astro";
import { SITE } from "../lib/site";
---
<Prose title="Contact | Gunther Heller" h1="Contact" path="/contact/"
  description="Email Gunther Heller to report a wrong calorie or nutrient number, or with a question about our USDA data."
  lead={`The fastest way to reach us is email: ${SITE.email}.`}>
  <h2>Reporting a wrong number</h2>
  <p>Please include three things: the page, the number you think is wrong, and where your number comes from (a USDA record, a package label). The "Report a correction" link at the bottom of each food page starts that email for you.</p>
  <h2>Questions about the data</h2>
  <p><a href="/methodology/">How we count</a> covers sources, servings and Daily Values. If it doesn't answer your question, write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
</Prose>
