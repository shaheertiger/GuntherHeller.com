---
import Fig from "../../components/Fig.astro";
import FigSection from "../../components/FigSection.astro";
import { figsFor } from "../../figures/cards";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import CatIcon from "../../components/CatIcon.astro";
import TrustBlock from "../../components/TrustBlock.astro";
import { CATEGORIES, FOODS, url, foodsIn } from "../../lib/data";
import { breadcrumbLd, ORG } from "../../lib/schema";
import { abs } from "../../lib/site";
import { hubIndexAlternates } from "../../lib/i18n";
const path = "/foods/";
const pf = figsFor("/foods/")!;
const crumbs = [{ name: "Home", href: "/" }, { name: "Foods" }];
const ld = { "@context": "https://schema.org", "@graph": [ORG, { "@type": "ItemList", name: "Food categories", itemListElement: CATEGORIES.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, url: abs(url.category(c.slug)) })) }, breadcrumbLd(crumbs, path)] };
---
<Base title={`Food Storage Times for ${FOODS.length} Foods, by Category | Gunther Heller`} description={`Browse storage times for ${FOODS.length} foods in ${CATEGORIES.length} categories: dairy, meat, poultry, seafood, produce, leftovers, pantry staples and more. USDA FoodKeeper data.`} path={path} jsonld={ld} alternates={hubIndexAlternates()} figs={pf}>
  <div class="container-site pt-4 md:pt-6">
    <Breadcrumb items={crumbs} />
    <h1 class="h1-food mt-5">All foods</h1>
    <p class="lead mt-3 max-w-[680px]">{FOODS.length} foods in {CATEGORIES.length} categories, each with counter, fridge and freezer times.</p>
    <Fig card={pf.hero} hero />
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-10">
      {CATEGORIES.map((c) => (
        <section class="border border-line rounded-[10px] p-5">
          <a href={url.category(c.slug)} class="flex items-center gap-4 group">
            <span class="paper w-14 h-14 rounded-[14px] grid place-items-center shrink-0"><CatIcon slug={c.slug} /></span>
            <span><h2 class="!text-[21px] !tracking-[-0.025em] group-hover:text-primary">{c.name}</h2><span class="text-sm text-muted">{c.count} foods</span></span>
          </a>
          <ul class="list-none p-0 mt-4 grid gap-1.5 text-[15px]">
            {foodsIn(c.slug).sort((a, b) => a.rank - b.rank).slice(0, 5).map((f) => <li><a href={url.food(f)}>{f.name}</a></li>)}
          </ul>
          <a href={url.category(c.slug)} class="link inline-block mt-3 text-sm">All {c.count} {c.name.toLowerCase()} →</a>
        </section>
      ))}
    </div>
    <FigSection id="categories" title="Foods by category" cards={pf.at("categories")} />
    <TrustBlock path={path} />
  </div>
</Base>
