---
import Base from "../layouts/Base.astro";
import Squiggle from "../components/Squiggle.astro";
import { NCATS, NMETA, RANKINGS, NFOODS, PROVEN, nurl, commonServing, kcalIn, type NFood } from "../lib/nutrition";
import { REVIEWER, personUrl } from "../lib/people";
import { ORG } from "../lib/schema";
import { SITE } from "../lib/site";

/** The foods people find this site for most (Search Console impressions, data/proven.json). */
const popular: NFood[] = [...NFOODS].sort((a, b) => PROVEN[b.slug].impressions - PROVEN[a.slug].impressions).slice(0, 24);
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    ORG,
    { "@type": "WebSite", "@id": `${SITE.url}/#site`, name: SITE.name, url: `${SITE.url}/`, publisher: { "@id": ORG["@id"] }, potentialAction: { "@type": "SearchAction", target: `${SITE.url}/search/?q={q}`, "query-input": "required name=q" } },
  ],
};
---
<Base title="Gunther Heller: How Many Calories Are in Your Food?" description={`Calories per serving and per 100 g, protein, carbs, fat, vitamins and minerals for ${NMETA.count.toLocaleString("en-US")} everyday foods, straight from USDA FoodData Central.`} path="/" jsonld={ld}>
  <section class="wrap pt-10 md:pt-16 max-w-[900px] text-center">
    <h1 class="text-[40px] md:text-[56px]">How many calories are in it?</h1>
    <Squiggle />
    <p class="intro mt-4">Type a food. You get its calories for the servings people actually eat, then protein, carbs, fat, vitamins and minerals. {NMETA.count.toLocaleString("en-US")} foods, all from USDA FoodData Central.</p>
    <form action="/search/" method="get" role="search" class="mt-7 flex gap-2 max-w-[620px] mx-auto">
      <label for="home-q" class="vh">Search foods</label>
      <input id="home-q" name="q" type="search" autocomplete="off" placeholder="Try: eggs, cooked rice, avocado" class="flex-1 h-12 border border-line rounded-lg px-4 text-base outline-none focus:border-primary-soft" />
      <button class="btn">Search</button>
    </form>
  </section>

  <section class="wrap mt-14" aria-labelledby="pop-h">
    <h2 id="pop-h" class="text-[28px]">Most looked-up foods</h2>
    <ul class="list-none p-0 m-0 mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {popular.map((f) => {
        const s = commonServing(f);
        return <li><a href={nurl.food(f)} class="tile hoverup flex justify-between items-center gap-3 px-4 py-3"><span class="font-[550]">{f.name}</span><span class="text-sm text-muted text-right">{kcalIn(f, s.grams)} cal<br /><span class="text-[12px]">{s.label}</span></span></a></li>;
      })}
    </ul>
  </section>

  <section class="wrap mt-14" aria-labelledby="cat-h">
    <h2 id="cat-h" class="text-[28px]">Browse by category</h2>
    <ul class="list-none p-0 m-0 mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {NCATS.map((c) => <li><a href={nurl.cat(c.slug)} class="tile hoverup flex justify-between items-center gap-3 px-4 py-3"><span class="font-[550]">{c.name}</span><span class="text-sm text-muted">{c.count}</span></a></li>)}
    </ul>
  </section>

  <section class="wrap mt-14" aria-labelledby="nut-h">
    <h2 id="nut-h" class="text-[28px]">Foods by nutrient</h2>
    <ul class="list-none p-0 m-0 mt-4 flex flex-wrap gap-2">
      {RANKINGS.map((r) => <li><a href={nurl.rank(r)} class="chip bg-tab hover:bg-tint-lilac">{r.h1}</a></li>)}
    </ul>
  </section>

  <section class="wrap mt-14 max-w-[900px]" aria-labelledby="about-h">
    <h2 id="about-h" class="text-[28px]">Where the numbers come from</h2>
    <p class="mt-3">Nutrition values come from USDA FoodData Central: Foundation Foods, SR Legacy and the FNDDS survey database used for What We Eat in America. Change the amount on any food page and the label recalculates. <a class="alink" href="/methodology/">How we use the data</a>. Our editorial standards are reviewed by <a class="alink" href={personUrl(REVIEWER)}>{REVIEWER.name}, {REVIEWER.credentials}</a>.</p>
  </section>
</Base>
